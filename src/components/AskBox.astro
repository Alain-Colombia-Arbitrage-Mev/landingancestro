---
const questions = [
  "What does Ancestro App do?",
  "Compare BYD Dolphin with Nissan Leaf",
  "Where can I take Test Drive?",
];
---

<div class="ask-box">
  <div class="ask-box-inner">
    <div class="ask-icon">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M21 11.5C21.0034 12.8199 20.6951 14.1219 20.1 15.3C19.3944 16.7118 18.3098 17.8992 16.9674 18.7293C15.6251 19.5594 14.0782 19.9994 12.5 20C11.1801 20.0035 9.87812 19.6951 8.7 19.1L3 21L4.9 15.3C4.30493 14.1219 3.99656 12.8199 4 11.5C4.00061 9.92179 4.44061 8.37488 5.27072 7.03258C6.10083 5.69028 7.28825 4.6056 8.7 3.90003C9.87812 3.30496 11.1801 2.99659 12.5 3.00003H13C15.0843 3.11502 17.053 3.99479 18.5291 5.47089C20.0052 6.94699 20.885 8.91568 21 11V11.5Z" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
    
    <span class="ask-label">Ask a Question</span>
    
    <div class="questions-wrapper">
      <div class="questions-track">
        <!-- Duplicamos la primera pregunta al final para transición suave -->
        {questions.map((question) => (
          <span class="question-item">"{question}"</span>
        ))}
        <span class="question-item">"{questions[0]}"</span>
      </div>
    </div>
    
    <div class="ask-icon-right">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect x="3" y="3" width="18" height="18" rx="3" stroke="white" stroke-width="2"/>
        <path d="M8 12L12 8L16 12" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M12 8V16" stroke="white" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </div>
  </div>
</div>

<style>
  .ask-box {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 100;
  }

  .ask-box-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 12px 20px;
    background-color: rgba(0, 0, 0, 0.9);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .ask-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.7;
    flex-shrink: 0;
  }

  .ask-label {
    font-size: 16px;
    font-weight: 500;
    color: var(--color-white);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .questions-wrapper {
    height: 24px;
    overflow: hidden;
    position: relative;
  }

  .questions-track {
    display: flex;
    flex-direction: column;
    animation: slideTrack 12s linear infinite;
  }

  .question-item {
    height: 24px;
    line-height: 24px;
    font-size: 16px;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.5);
    white-space: nowrap;
    flex-shrink: 0;
  }

  @keyframes slideTrack {
    0% {
      transform: translateY(0);
    }
    22% {
      transform: translateY(0);
    }
    25% {
      transform: translateY(-24px);
    }
    47% {
      transform: translateY(-24px);
    }
    50% {
      transform: translateY(-48px);
    }
    72% {
      transform: translateY(-48px);
    }
    75% {
      transform: translateY(-72px);
    }
    100% {
      transform: translateY(-72px);
    }
  }

  .ask-icon-right {
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.5;
    flex-shrink: 0;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .ask-box-inner {
      padding: 10px 16px;
    }

    .ask-label,
    .question-item {
      font-size: 14px;
    }

    .questions-wrapper {
      height: 20px;
    }

    .question-item {
      height: 20px;
      line-height: 20px;
    }

    @keyframes slideTrack {
      0% {
        transform: translateY(0);
      }
      22% {
        transform: translateY(0);
      }
      25% {
        transform: translateY(-20px);
      }
      47% {
        transform: translateY(-20px);
      }
      50% {
        transform: translateY(-40px);
      }
      72% {
        transform: translateY(-40px);
      }
      75% {
        transform: translateY(-60px);
      }
      100% {
        transform: translateY(-60px);
      }
    }
  }

  @media (max-width: 520px) {
    .questions-wrapper {
      display: none;
    }
  }
</style>
