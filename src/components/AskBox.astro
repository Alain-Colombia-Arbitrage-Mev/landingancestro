---
const questions = [
  "¿Cuánto puedo ahorrar con paneles solares?",
  "¿Cómo funciona el modelo de suscripción?",
  "¿En qué países está disponible Ancestro?",
  "¿Qué incluye la instalación?",
  "¿Cuánto tarda la instalación?",
  "¿Puedo cargar mi vehículo eléctrico?",
  "¿Hay costos ocultos?",
  "¿Qué pasa si me mudo de casa?",
];
---

<div class="ask-box">
  <div class="ask-box-inner">
    <!-- Floating Questions Animation -->
    <div class="floating-questions" aria-hidden="true">
      {questions.map((question, index) => (
        <div class="floating-question" style={`--delay: ${index * 2.5}s; --index: ${index}`}>
          <span class="question-text">{question}</span>
        </div>
      ))}
    </div>
    
    <!-- Main Input Area -->
    <div class="ask-input-container">
      <div class="ask-icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M21 11.5C21.0034 12.8199 20.6951 14.1219 20.1 15.3C19.3944 16.7118 18.3098 17.8992 16.9674 18.7293C15.6251 19.5594 14.0782 19.9994 12.5 20C11.1801 20.0035 9.87812 19.6951 8.7 19.1L3 21L4.9 15.3C4.30493 14.1219 3.99656 12.8199 4 11.5C4.00061 9.92179 4.44061 8.37488 5.27072 7.03258C6.10083 5.69028 7.28825 4.6056 8.7 3.90003C9.87812 3.30496 11.1801 2.99659 12.5 3.00003H13C15.0843 3.11502 17.053 3.99479 18.5291 5.47089C20.0052 6.94699 20.885 8.91568 21 11V11.5Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      
      <div class="ask-content">
        <span class="ask-label">Pregúntale a Ancestro</span>
        <div class="typing-indicator">
          <span class="typing-dot"></span>
          <span class="typing-dot"></span>
          <span class="typing-dot"></span>
        </div>
      </div>
      
      <button class="ask-submit" aria-label="Enviar pregunta">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M22 2L11 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M22 2L15 22L11 13L2 9L22 2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
  </div>
</div>

<style>
  .ask-box {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 0 20px;
  }

  .ask-box-inner {
    position: relative;
    max-width: 800px;
    margin: 0 auto;
    padding-bottom: 20px;
  }

  /* Floating Questions */
  .floating-questions {
    position: absolute;
    bottom: 100%;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    height: 200px;
    pointer-events: none;
    overflow: hidden;
    mask-image: linear-gradient(to top, rgba(0,0,0,1) 20%, rgba(0,0,0,0) 100%);
    -webkit-mask-image: linear-gradient(to top, rgba(0,0,0,1) 20%, rgba(0,0,0,0) 100%);
  }

  .floating-question {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    opacity: 0;
    animation: floatUp 20s infinite;
    animation-delay: var(--delay);
  }

  .question-text {
    display: inline-block;
    padding: 12px 24px;
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 50px;
    font-size: 15px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.9);
    white-space: nowrap;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
  }

  @keyframes floatUp {
    0% {
      opacity: 0;
      transform: translateX(-50%) translateY(20px);
    }
    2% {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }
    10% {
      opacity: 1;
      transform: translateX(-50%) translateY(-60px);
    }
    12% {
      opacity: 0;
      transform: translateX(-50%) translateY(-80px);
    }
    100% {
      opacity: 0;
      transform: translateX(-50%) translateY(-80px);
    }
  }

  /* Different positions for variety */
  .floating-question:nth-child(1) { left: 30%; }
  .floating-question:nth-child(2) { left: 70%; }
  .floating-question:nth-child(3) { left: 45%; }
  .floating-question:nth-child(4) { left: 55%; }
  .floating-question:nth-child(5) { left: 35%; }
  .floating-question:nth-child(6) { left: 65%; }
  .floating-question:nth-child(7) { left: 50%; }
  .floating-question:nth-child(8) { left: 40%; }

  /* Main Input Container */
  .ask-input-container {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 24px;
    background: rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(30px);
    -webkit-backdrop-filter: blur(30px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 60px;
    box-shadow: 
      0 8px 32px rgba(0, 0, 0, 0.3),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
    transition: all 0.3s ease;
  }

  .ask-input-container:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(248, 176, 59, 0.3);
    box-shadow: 
      0 12px 40px rgba(0, 0, 0, 0.4),
      0 0 20px rgba(248, 176, 59, 0.1),
      inset 0 1px 0 rgba(255, 255, 255, 0.15);
  }

  .ask-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: rgba(248, 176, 59, 0.15);
    border-radius: 50%;
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .ask-content {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .ask-label {
    font-size: 18px;
    font-weight: 500;
    color: var(--color-white);
  }

  /* Typing Indicator */
  .typing-indicator {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .typing-dot {
    width: 6px;
    height: 6px;
    background: rgba(255, 255, 255, 0.4);
    border-radius: 50%;
    animation: typingBounce 1.4s infinite ease-in-out;
  }

  .typing-dot:nth-child(1) { animation-delay: 0s; }
  .typing-dot:nth-child(2) { animation-delay: 0.2s; }
  .typing-dot:nth-child(3) { animation-delay: 0.4s; }

  @keyframes typingBounce {
    0%, 60%, 100% {
      transform: translateY(0);
      opacity: 0.4;
    }
    30% {
      transform: translateY(-6px);
      opacity: 1;
    }
  }

  .ask-submit {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background: var(--color-primary);
    border: none;
    border-radius: 50%;
    color: var(--color-black);
    cursor: pointer;
    flex-shrink: 0;
    transition: all 0.3s ease;
  }

  .ask-submit:hover {
    background: #e9a235;
    transform: scale(1.05);
    box-shadow: 0 4px 20px rgba(248, 176, 59, 0.4);
  }

  .ask-submit:active {
    transform: scale(0.95);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .ask-box {
      padding: 0 16px;
    }

    .floating-questions {
      height: 150px;
    }

    .question-text {
      font-size: 13px;
      padding: 10px 18px;
    }

    .ask-input-container {
      padding: 12px 18px;
      gap: 12px;
    }

    .ask-icon {
      width: 38px;
      height: 38px;
    }

    .ask-icon svg {
      width: 20px;
      height: 20px;
    }

    .ask-label {
      font-size: 15px;
    }

    .ask-submit {
      width: 42px;
      height: 42px;
    }

    .ask-submit svg {
      width: 18px;
      height: 18px;
    }

    .typing-indicator {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .floating-questions {
      display: none;
    }

    .ask-input-container {
      padding: 10px 14px;
      gap: 10px;
    }

    .ask-icon {
      width: 34px;
      height: 34px;
    }

    .ask-label {
      font-size: 14px;
    }

    .ask-submit {
      width: 38px;
      height: 38px;
    }
  }
</style>
