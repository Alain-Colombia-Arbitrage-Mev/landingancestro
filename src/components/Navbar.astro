---
import CTA from './CTA.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

interface NavItem {
  label: string;
  href: string;
  key: string;
}

const navItems: NavItem[] = [
  { label: t('nav.energy'), href: '#energy', key: 'energy' },
  { label: t('nav.charging'), href: '#charging', key: 'charging' },
  { label: t('nav.vehicles'), href: '#vehicles', key: 'vehicles' },
  // { label: t('nav.shop'), href: '#shop', key: 'shop' },
  // { label: t('nav.presale'), href: translatePath('/presale'), key: 'presale' },
  // { label: t('nav.invest'), href: translatePath('/invest'), key: 'invest' },
  { label: t('nav.team'), href: translatePath('/team'), key: 'team' },
  { label: t('nav.contact'), href: translatePath('/contact'), key: 'contact' },
  { label: t('nav.waitlist'), href: translatePath('/waitlist'), key: 'waitlist' },
];

const homeHref = translatePath('/');
---

<nav class="navbar" role="navigation" aria-label={t('common.ariaNavigation')}>
  <div class="navbar-inner">
    <a href={homeHref} class="logo" aria-label={t('common.ariaGoHome')}>
      <img src="/logo.svg" alt="Ancestro Logo" class="logo-img" width="200" height="40" />
    </a>

    <!-- Desktop Navigation -->
    <div class="nav-links-desktop">
      {navItems.map((item) => (
        <a 
          href={item.href} 
          class:list={['nav-link', { 'nav-link-highlight': item.key === 'presale' || item.key === 'invest' }]}
        >
          {item.label}
        </a>
      ))}
    </div>

    <div class="nav-right-desktop">
      <LanguageSwitcher />
      <!-- Login button (hidden for now) -->
      <div id="nav-login-btn" style="display:none;">
        <CTA variant="secondary" text={t('nav.login')} href={translatePath('/login')} ariaLabel={t('nav.login')} />
      </div>
      <!-- User menu (shown when authenticated) -->
      <div id="nav-user-menu" class="nav-user-menu" style="display:none;">
        <button class="nav-user-trigger" id="user-menu-trigger" aria-expanded="false">
          <span class="nav-user-avatar" id="nav-avatar-letter"></span>
          <span class="nav-user-name" id="nav-user-name"></span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <div class="nav-user-dropdown" id="user-dropdown">
          <a href={translatePath('/dashboard')} class="nav-dropdown-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            {t('auth.dashboard')}
          </a>
          <button class="nav-dropdown-item nav-dropdown-logout" id="nav-logout-btn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            {t('auth.logout')}
          </button>
        </div>
      </div>
    </div>

    <!-- Mobile Hamburger Button -->
    <div class="nav-right-mobile">
      <LanguageSwitcher />
      <button
        class="hamburger"
        id="hamburger-btn"
        aria-label={t('common.ariaOpenMenu')}
        aria-expanded="false"
      >
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Overlay -->
  <div class="mobile-overlay" id="mobile-overlay"></div>

  <!-- Mobile Menu -->
  <div class="mobile-menu" id="mobile-menu">
    <div class="mobile-menu-content">
      <div class="mobile-nav-links">
        {navItems.map((item) => (
          <a 
            href={item.href} 
            class:list={['mobile-nav-link', { 'mobile-nav-link-highlight': item.key === 'presale' || item.key === 'invest' }]}
          >
            {item.label}
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
              <path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        ))}
      </div>
      
      <div class="mobile-cta" id="mobile-login-cta" style="display:none;">
        <CTA variant="primary" text={t('nav.login')} href={translatePath('/login')} ariaLabel={t('nav.login')} />
      </div>
      <div class="mobile-cta" id="mobile-user-cta" style="display:none;">
        <a href={translatePath('/dashboard')} class="mobile-nav-link" style="opacity:1;transform:none;">
          {t('auth.dashboard')}
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <button id="mobile-logout-btn" class="mobile-logout-btn">
          {t('auth.logout')}
        </button>
      </div>
      
      <div class="mobile-footer">
        <p>{t('common.joinRevolution')}</p>
        <div class="mobile-socials">
          <a href="#" aria-label="Twitter">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
              <path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <a href="#" aria-label="Instagram">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
              <rect x="2" y="2" width="20" height="20" rx="5" stroke="currentColor" stroke-width="2"/>
              <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2"/>
              <circle cx="18" cy="6" r="1" fill="currentColor"/>
            </svg>
          </a>
          <a href="#" aria-label="LinkedIn">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" stroke="currentColor" stroke-width="2"/>
              <rect x="2" y="9" width="4" height="12" stroke="currentColor" stroke-width="2"/>
              <circle cx="4" cy="4" r="2" stroke="currentColor" stroke-width="2"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</nav>

<script>
  const hamburgerBtn = document.getElementById('hamburger-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileOverlay = document.getElementById('mobile-overlay');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');
  const navbar = document.querySelector('.navbar');

  let isOpen = false;

  function toggleMenu() {
    isOpen = !isOpen;
    
    hamburgerBtn?.classList.toggle('active', isOpen);
    mobileMenu?.classList.toggle('active', isOpen);
    mobileOverlay?.classList.toggle('active', isOpen);
    navbar?.classList.toggle('menu-open', isOpen);
    
    hamburgerBtn?.setAttribute('aria-expanded', isOpen.toString());
    document.body.style.overflow = isOpen ? 'hidden' : '';
  }

  function closeMenu() {
    if (isOpen) {
      toggleMenu();
    }
  }

  hamburgerBtn?.addEventListener('click', toggleMenu);
  mobileOverlay?.addEventListener('click', closeMenu);
  
  mobileLinks.forEach(link => {
    link.addEventListener('click', () => {
      setTimeout(closeMenu, 150);
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen) {
      closeMenu();
    }
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth > 1024 && isOpen) {
      closeMenu();
    }
  });

  // ===== AUTH STATE =====
  import { initAuth } from '../lib/auth-init';
  import { currentUser, logout } from '../stores/user';

  // Initialize auth on every page that has a Navbar
  initAuth();

  function updateNavAuth() {
    const user = currentUser.get();
    const loginBtn = document.getElementById('nav-login-btn');
    const userMenu = document.getElementById('nav-user-menu');
    const mobileLoginCta = document.getElementById('mobile-login-cta');
    const mobileUserCta = document.getElementById('mobile-user-cta');

    if (user) {
      loginBtn && (loginBtn.style.display = 'none');
      userMenu && (userMenu.style.display = 'block');
      mobileLoginCta && (mobileLoginCta.style.display = 'none');
      mobileUserCta && (mobileUserCta.style.display = 'block');

      const avatarEl = document.getElementById('nav-avatar-letter');
      const nameEl = document.getElementById('nav-user-name');
      if (avatarEl) avatarEl.textContent = (user.name || user.email)[0].toUpperCase();
      if (nameEl) nameEl.textContent = user.name || user.email.split('@')[0];
    } else {
      loginBtn && (loginBtn.style.display = 'none');
      userMenu && (userMenu.style.display = 'none');
      mobileLoginCta && (mobileLoginCta.style.display = 'none');
      mobileUserCta && (mobileUserCta.style.display = 'none');
    }
  }

  // Initial check
  updateNavAuth();

  // Listen for changes
  currentUser.subscribe(updateNavAuth);

  // Desktop user dropdown toggle
  const userMenuTrigger = document.getElementById('user-menu-trigger');
  const userDropdown = document.getElementById('user-dropdown');

  userMenuTrigger?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isExpanded = userMenuTrigger.getAttribute('aria-expanded') === 'true';
    userMenuTrigger.setAttribute('aria-expanded', (!isExpanded).toString());
    userDropdown?.classList.toggle('active', !isExpanded);
  });

  document.addEventListener('click', () => {
    userMenuTrigger?.setAttribute('aria-expanded', 'false');
    userDropdown?.classList.remove('active');
  });

  // Logout handlers
  const navLogoutBtn = document.getElementById('nav-logout-btn');
  const mobileLogoutBtn = document.getElementById('mobile-logout-btn');

  async function handleLogout() {
    await logout();
    window.location.href = '/';
  }

  navLogoutBtn?.addEventListener('click', handleLogout);
  mobileLogoutBtn?.addEventListener('click', handleLogout);
</script>

<style>
  /* ===== NAVBAR BASE ===== */
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 79px;
    background-color: var(--color-black-50);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    z-index: 1000;
  }

  .navbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    max-width: 1920px;
    margin: 0 auto;
    padding: 0 30px;
  }

  /* ===== LOGO ===== */
  .logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    transition: opacity 0.2s ease;
    position: relative;
    z-index: 1002;
  }

  .logo:hover {
    opacity: 0.9;
  }

  .logo-img {
    height: 40px;
    width: auto;
    object-fit: contain;
  }

  /* ===== DESKTOP NAVIGATION ===== */
  .nav-links-desktop {
    display: flex;
    align-items: center;
    gap: 4px;
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
  }

  .nav-link {
    padding: 10px 10px;
    font-size: 14px;
    font-weight: 600;
    color: var(--color-white);
    text-decoration: none;
    transition: opacity var(--transition-fast);
    border-radius: 8px;
    white-space: nowrap;
  }

  .nav-link:hover {
    opacity: 0.8;
  }

  .nav-link-highlight {
    color: var(--color-primary);
  }

  .nav-right-desktop {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  /* ===== USER MENU ===== */
  .nav-user-menu {
    position: relative;
  }

  .nav-user-trigger {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 12px;
    cursor: pointer;
    color: var(--color-white);
    font-family: var(--font-family);
    font-size: 14px;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .nav-user-trigger:hover {
    background: rgba(255, 255, 255, 0.15);
  }

  .nav-user-avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(248, 176, 59, 0.2);
    color: var(--color-primary);
    font-weight: 700;
    font-size: 13px;
  }

  .nav-user-dropdown {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    min-width: 180px;
    background: rgba(20, 20, 20, 0.95);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 6px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition: all 0.2s ease;
    z-index: 1010;
  }

  .nav-user-dropdown.active {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .nav-dropdown-item {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 10px 14px;
    background: none;
    border: none;
    border-radius: 8px;
    color: var(--color-white);
    font-family: var(--font-family);
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .nav-dropdown-item:hover {
    background: rgba(255, 255, 255, 0.08);
  }

  .nav-dropdown-logout {
    color: #ef4444;
  }

  .nav-right-mobile {
    display: none;
  }

  /* ===== HAMBURGER - HIDDEN ON DESKTOP ===== */
  .hamburger {
    display: none;
  }

  /* ===== MOBILE OVERLAY - HIDDEN ON DESKTOP ===== */
  .mobile-overlay {
    display: none;
  }

  /* ===== MOBILE MENU - HIDDEN ON DESKTOP ===== */
  .mobile-menu {
    display: none;
  }

  /* ===== RESPONSIVE - TABLET/MOBILE ===== */
  @media (max-width: 1024px) {
    .navbar-inner {
      padding: 0 16px;
    }

    .logo-img {
      height: 35px;
    }

    /* Hide desktop nav */
    .nav-links-desktop,
    .nav-right-desktop {
      display: none;
    }

    /* Show mobile right section */
    .nav-right-mobile {
      display: flex;
      align-items: center;
      gap: 12px;
      z-index: 1002;
    }

    /* Show hamburger */
    .hamburger {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      width: 44px;
      height: 44px;
      padding: 10px;
      background: rgba(255, 255, 255, 0.1);
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 12px;
      cursor: pointer;
      transition: all 0.3s ease;
    }

    .hamburger:hover {
      background: rgba(255, 255, 255, 0.15);
    }

    .hamburger-line {
      display: block;
      width: 20px;
      height: 2px;
      background-color: var(--color-white);
      border-radius: 2px;
      transition: all 0.3s cubic-bezier(0.68, -0.6, 0.32, 1.6);
    }

    .hamburger-line:nth-child(1) {
      margin-bottom: 5px;
    }

    .hamburger-line:nth-child(3) {
      margin-top: 5px;
    }

    .hamburger.active {
      background: rgba(248, 176, 59, 0.2);
      border-color: rgba(248, 176, 59, 0.3);
    }

    .hamburger.active .hamburger-line:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }

    .hamburger.active .hamburger-line:nth-child(2) {
      opacity: 0;
      transform: scaleX(0);
    }

    .hamburger.active .hamburger-line:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }

    /* Overlay hidden since menu is full width */
    .mobile-overlay {
      display: none;
    }

    /* Show mobile menu - Full width */
    .mobile-menu {
      display: block;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      width: 100%;
      height: 100vh;
      height: 100dvh;
      background: rgba(5, 5, 5, 0.97);
      backdrop-filter: blur(40px);
      -webkit-backdrop-filter: blur(40px);
      opacity: 0;
      visibility: hidden;
      transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      z-index: 1001;
      overflow-y: auto;
    }

    .mobile-menu.active {
      opacity: 1;
      visibility: visible;
    }

    .mobile-menu-content {
      display: flex;
      flex-direction: column;
      min-height: 100%;
      padding: 100px 24px 40px;
      max-width: 500px;
      margin: 0 auto;
    }

    .mobile-nav-links {
      display: flex;
      flex-direction: column;
      gap: 12px;
      flex: 1;
    }

    .mobile-nav-link {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 20px 24px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 16px;
      color: var(--color-white);
      font-size: 18px;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.3s ease;
      opacity: 0;
      transform: translateY(20px);
    }

    .mobile-menu.active .mobile-nav-link {
      opacity: 1;
      transform: translateY(0);
    }

    /* Staggered animation for links */
    .mobile-menu.active .mobile-nav-link:nth-child(1) { transition-delay: 0.05s; }
    .mobile-menu.active .mobile-nav-link:nth-child(2) { transition-delay: 0.1s; }
    .mobile-menu.active .mobile-nav-link:nth-child(3) { transition-delay: 0.15s; }
    .mobile-menu.active .mobile-nav-link:nth-child(4) { transition-delay: 0.2s; }
    .mobile-menu.active .mobile-nav-link:nth-child(5) { transition-delay: 0.25s; }
    .mobile-menu.active .mobile-nav-link:nth-child(6) { transition-delay: 0.3s; }
    .mobile-menu.active .mobile-nav-link:nth-child(7) { transition-delay: 0.35s; }

    .mobile-nav-link:hover,
    .mobile-nav-link:active {
      background: rgba(255, 255, 255, 0.08);
      border-color: rgba(248, 176, 59, 0.4);
      transform: scale(1.02);
    }

    .mobile-nav-link svg {
      color: var(--color-gray);
      transition: all 0.3s ease;
    }

    .mobile-nav-link:hover svg {
      color: var(--color-primary);
      transform: translateX(4px);
    }

    .mobile-nav-link-highlight {
      background: linear-gradient(135deg, rgba(248, 176, 59, 0.15), rgba(248, 176, 59, 0.05));
      border-color: rgba(248, 176, 59, 0.4);
      color: var(--color-primary);
    }

    .mobile-cta {
      margin-top: 32px;
      padding-top: 24px;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      opacity: 0;
      transform: translateY(20px);
      transition: all 0.4s ease 0.35s;
    }

    .mobile-menu.active .mobile-cta {
      opacity: 1;
      transform: translateY(0);
    }

    .mobile-cta :global(.cta) {
      width: 100%;
      justify-content: center;
      padding: 18px;
      font-size: 17px;
      border-radius: 14px;
    }

    .mobile-footer {
      margin-top: 32px;
      text-align: center;
      opacity: 0;
      transform: translateY(20px);
      transition: all 0.4s ease 0.4s;
    }

    .mobile-menu.active .mobile-footer {
      opacity: 1;
      transform: translateY(0);
    }

    .mobile-footer p {
      font-size: 14px;
      color: var(--color-gray);
      margin-bottom: 16px;
    }

    .mobile-socials {
      display: flex;
      justify-content: center;
      gap: 16px;
    }

    .mobile-socials a {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 48px;
      height: 48px;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 12px;
      color: var(--color-gray);
      transition: all 0.3s ease;
    }

    .mobile-socials a:hover {
      background: rgba(248, 176, 59, 0.15);
      border-color: rgba(248, 176, 59, 0.4);
      color: var(--color-primary);
      transform: translateY(-3px);
    }

    .mobile-logout-btn {
      width: 100%;
      margin-top: 12px;
      padding: 16px;
      background: rgba(239, 68, 68, 0.1);
      border: 1px solid rgba(239, 68, 68, 0.3);
      border-radius: 14px;
      color: #ef4444;
      font-family: var(--font-family);
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .mobile-logout-btn:hover {
      background: rgba(239, 68, 68, 0.2);
    }
  }

  @media (max-width: 380px) {
    .mobile-menu-content {
      padding: 90px 20px 30px;
    }

    .mobile-nav-link {
      padding: 18px 20px;
      font-size: 17px;
    }
  }
</style>
