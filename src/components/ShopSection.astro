---
import ProductCard from './ProductCard.astro';

interface Product {
  title: string;
  description: string;
  backgroundImage: string;
}

interface Props {
  products: Product[];
}

const { products } = Astro.props;
---

<section class="shop-section" id="shop" aria-label="Productos disponibles">
  <div class="shop-inner">
    {products.map((product) => (
      <ProductCard 
        title={product.title}
        description={product.description}
        backgroundImage={product.backgroundImage}
      />
    ))}
  </div>
</section>

<style>
  .shop-section {
    width: 100%;
    max-width: 1920px;
    margin: 0 auto;
  }

  .shop-inner {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    width: 100%;
  }

  /* Tablet large */
  @media (max-width: 1200px) {
    .shop-inner {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
  }

  /* Tablet */
  @media (max-width: 768px) {
    .shop-inner {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
  }

  /* Mobile */
  @media (max-width: 580px) {
    .shop-inner {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
</style>
