---
const team = [
  {
    name: "Alejandro Restrepo",
    role: "Founder & CEO",
    bio: "Serial entrepreneur with 15+ years in renewable energy and fintech across LATAM. Previously founded two clean energy startups with successful exits.",
    image: null,
    linkedin: "#",
  },
  {
    name: "María del Carmen Vega",
    role: "COO",
    bio: "Former VP of Operations at a leading solar distributor in Latin America. Expert in supply chain and multi-country expansion.",
    image: null,
    linkedin: "#",
  },
  {
    name: "Daniel Ochoa",
    role: "CTO",
    bio: "Full-stack architect with deep experience building fintech platforms. Previously led engineering at a Series B proptech startup.",
    image: null,
    linkedin: "#",
  },
  {
    name: "Sarah Mitchell",
    role: "Head of Capital Markets",
    bio: "10+ years in institutional finance and venture capital. Managed over $200M in clean energy investment vehicles.",
    image: null,
    linkedin: "#",
  },
  {
    name: "Carlos Andrade",
    role: "Head of LATAM Expansion",
    bio: "Political strategist and regulatory expert. Built government partnerships in 12 countries for energy and infrastructure projects.",
    image: null,
    linkedin: "#",
  },
  {
    name: "Valentina Torres",
    role: "Head of Community & Brand",
    bio: "Former creative director at a top-tier agency. Built purpose-driven brands with communities exceeding 500K members.",
    image: null,
    linkedin: "#",
  },
];

const advisors = [
  {
    name: "James Whitfield",
    role: "Energy Policy Advisor",
    bio: "Former advisor to the U.S. Department of Energy. 25 years in renewable energy regulation.",
  },
  {
    name: "Dr. Lucía Herrera",
    role: "Health & Wellness Advisor",
    bio: "Functional medicine physician and ancestral health researcher. Published author on longevity protocols.",
  },
  {
    name: "Ricardo Mendes",
    role: "Carbon Markets Advisor",
    bio: "Pioneered carbon credit verification frameworks across South America. Board member of two carbon registries.",
  },
];

function getInitials(name: string): string {
  return name.split(' ').map(n => n[0]).join('').slice(0, 2);
}
---

<section class="team-section">
  <div class="container">
    <div class="section-label">The People</div>
    <h2 class="section-title">Led by Operators, <span class="highlight">Not Spectators</span></h2>
    <p class="section-intro">
      Ancestro is built by a team that has deployed capital, built platforms, navigated regulation, and scaled across emerging markets — not from a pitch deck, but from the ground.
    </p>

    <div class="team-grid">
      {team.map((member) => (
        <div class="team-card">
          <div class="team-avatar">
            <span class="avatar-initials">{getInitials(member.name)}</span>
          </div>
          <div class="team-info">
            <h3 class="team-name">{member.name}</h3>
            <span class="team-role">{member.role}</span>
            <p class="team-bio">{member.bio}</p>
            <a href={member.linkedin} class="team-linkedin" aria-label={`${member.name} LinkedIn`}>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
                <rect x="2" y="9" width="4" height="12"/>
                <circle cx="4" cy="4" r="2"/>
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>

    <div class="advisors-section">
      <h3 class="advisors-title">Advisory Board</h3>
      <div class="advisors-grid">
        {advisors.map((advisor) => (
          <div class="advisor-card">
            <div class="advisor-avatar">
              <span>{getInitials(advisor.name)}</span>
            </div>
            <h4 class="advisor-name">{advisor.name}</h4>
            <span class="advisor-role">{advisor.role}</span>
            <p class="advisor-bio">{advisor.bio}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .team-section {
    padding: 100px 24px;
    background: linear-gradient(180deg, transparent 0%, rgba(248,176,59,0.02) 50%, transparent 100%);
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .section-label {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-primary);
    text-align: center;
    margin-bottom: 12px;
  }

  .section-title {
    font-size: clamp(24px, 3.5vw, 36px);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-white);
    text-align: center;
    margin-bottom: 20px;
  }

  .highlight {
    color: var(--color-primary);
  }

  .section-intro {
    font-size: 17px;
    color: rgba(255,255,255,0.6);
    text-align: center;
    max-width: 700px;
    margin: 0 auto 60px;
    line-height: 1.7;
  }

  /* Team Grid */
  .team-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 80px;
  }

  .team-card {
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 20px;
    padding: 32px 24px;
    text-align: center;
    transition: all 0.3s ease;
  }

  .team-card:hover {
    border-color: rgba(248,176,59,0.2);
    transform: translateY(-4px);
  }

  .team-avatar {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: linear-gradient(135deg, rgba(248,176,59,0.2), rgba(248,176,59,0.05));
    border: 2px solid rgba(248,176,59,0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 20px;
  }

  .avatar-initials {
    font-size: 22px;
    font-weight: 700;
    color: var(--color-primary);
    letter-spacing: 0.02em;
  }

  .team-info {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }

  .team-name {
    font-size: 17px;
    font-weight: 700;
    color: var(--color-white);
  }

  .team-role {
    font-size: 13px;
    font-weight: 600;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .team-bio {
    font-size: 13px;
    color: rgba(255,255,255,0.5);
    line-height: 1.6;
    margin-top: 8px;
  }

  .team-linkedin {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: rgba(255,255,255,0.06);
    color: rgba(255,255,255,0.4);
    margin-top: 12px;
    transition: all 0.2s ease;
  }

  .team-linkedin:hover {
    background: rgba(248,176,59,0.15);
    color: var(--color-primary);
  }

  /* Advisors */
  .advisors-title {
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(255,255,255,0.4);
    text-align: center;
    margin-bottom: 32px;
  }

  .advisors-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .advisor-card {
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 16px;
    padding: 28px 20px;
    text-align: center;
  }

  .advisor-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgba(255,255,255,0.06);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 14px;
    font-size: 15px;
    font-weight: 600;
    color: rgba(255,255,255,0.5);
  }

  .advisor-name {
    font-size: 15px;
    font-weight: 600;
    color: var(--color-white);
    margin-bottom: 4px;
  }

  .advisor-role {
    font-size: 12px;
    font-weight: 500;
    color: rgba(255,255,255,0.4);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .advisor-bio {
    font-size: 13px;
    color: rgba(255,255,255,0.4);
    line-height: 1.5;
    margin-top: 10px;
  }

  @media (max-width: 900px) {
    .team-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .team-section {
      padding: 60px 20px;
    }

    .team-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .advisors-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
