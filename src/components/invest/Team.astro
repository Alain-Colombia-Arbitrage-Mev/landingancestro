function getInitials(name: string): string {
  const prefixes = ['Dr.', 'Mr.', 'Ms.', 'Mrs.'];
  const parts = name.split(' ').filter(n => !prefixes.includes(n));
  return parts.map(n => n[0]).join('').slice(0, 2);
}
---

