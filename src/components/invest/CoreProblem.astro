---

<section class="core-problem" id="core-problem">
  <div class="container">
    <div class="section-label">The Problem</div>
    <h2 class="section-heading">Two Converging Crises</h2>

    <div class="problems-grid">
      <div class="problem-card" data-animate>
        <div class="card-number">01</div>
        <h3 class="card-title">Energy Infrastructure</h3>
        <p class="card-description">
          Renewable energy adoption is constrained not by demand, but by systemic failures across the value chain.
        </p>
        <ul class="card-points">
          <li>Fragmented stakeholders across generation, distribution, and consumption</li>
          <li>Poor coordination between customers, installers, distributors, and capital providers</li>
          <li>Lack of scalable platforms that unify the ecosystem end-to-end</li>
          <li>Centralized utilities that actively resist decentralization</li>
        </ul>
      </div>

      <div class="problem-card" data-animate>
        <div class="card-number">02</div>
        <h3 class="card-title">The Human Crisis</h3>
        <p class="card-description">
          Modern lifestyles are producing compounding failures in health, environment, and social cohesion.
        </p>
        <ul class="card-points">
          <li>Chronic disease driven by disconnection from natural systems</li>
          <li>Environmental degradation accelerating beyond recovery thresholds</li>
          <li>Loss of meaning, ritual, and community at a civilizational scale</li>
        </ul>
      </div>
    </div>

    <div class="bottom-statement" data-animate>
      <p>These are not separate problems. They share a common root &mdash; and they demand a <span class="accent">unified solution</span>.</p>
    </div>
  </div>
</section>

<style>
  .core-problem {
    padding: 64px 24px;
    background: var(--color-black);
    position: relative;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-primary);
    text-align: center;
    margin-bottom: 16px;
  }

  .section-heading {
    font-size: 2.25rem;
    font-weight: 600;
    color: var(--color-white);
    text-align: center;
    margin-bottom: 40px;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .problems-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    margin-bottom: 72px;
  }

  .problem-card {
    border: 1px solid var(--color-white-10);
    border-radius: 12px;
    padding: 40px;
    background: transparent;
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .problem-card.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .card-number {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-primary);
    letter-spacing: 0.05em;
    margin-bottom: 20px;
    font-variant-numeric: tabular-nums;
  }

  .card-title {
    font-size: 1.375rem;
    font-weight: 600;
    color: var(--color-white);
    margin-bottom: 12px;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .card-description {
    font-size: 0.9375rem;
    color: var(--color-gray);
    line-height: 1.7;
    margin-bottom: 28px;
  }

  .card-points {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .card-points li {
    font-size: 0.9375rem;
    color: rgba(255, 255, 255, 0.72);
    line-height: 1.6;
    padding: 14px 0;
    border-top: 1px solid var(--color-white-10);
  }

  .card-points li:last-child {
    padding-bottom: 0;
  }

  .bottom-statement {
    text-align: center;
    max-width: 640px;
    margin: 0 auto;
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.15s,
                transform 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.15s;
  }

  .bottom-statement.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .bottom-statement p {
    font-size: 1.0625rem;
    font-weight: 400;
    color: var(--color-gray);
    line-height: 1.7;
  }

  .bottom-statement .accent {
    color: var(--color-primary);
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .core-problem {
      padding: 40px 20px;
    }

    .section-heading {
      font-size: 1.75rem;
      margin-bottom: 28px;
    }

    .problems-grid {
      grid-template-columns: 1fr;
      gap: 24px;
      margin-bottom: 32px;
    }

    .problem-card {
      padding: 32px 28px;
    }

    .card-title {
      font-size: 1.25rem;
    }
  }
</style>

<script>
  function initCoreProblem() {
    const elements = document.querySelectorAll('#core-problem [data-animate]');
    if (!elements.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry, i) => {
          if (entry.isIntersecting) {
            setTimeout(() => {
              entry.target.classList.add('visible');
            }, i * 120);
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
    );

    elements.forEach((el) => observer.observe(el));
  }

  document.addEventListener('astro:page-load', initCoreProblem);
  initCoreProblem();
</script>
