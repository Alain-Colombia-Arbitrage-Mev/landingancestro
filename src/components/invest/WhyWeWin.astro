<section class="why-we-win">
  <div class="container">
    <h2 class="section-title">Why Ancestro Is <span class="highlight">Inevitable</span></h2>

    <div class="advantages">
      <div class="advantage-item">
        <div class="advantage-number">01</div>
        <div class="advantage-text">
          <h3>Platform model vs. asset-heavy competitors</h3>
        </div>
      </div>
      <div class="advantage-item">
        <div class="advantage-number">02</div>
        <div class="advantage-text">
          <h3>First-mover advantage in emerging renewable markets</h3>
        </div>
      </div>
      <div class="advantage-item">
        <div class="advantage-number">03</div>
        <div class="advantage-text">
          <h3>Multi-vertical expansion (solar, wind, EV charging, carbon)</h3>
        </div>
      </div>
      <div class="advantage-item">
        <div class="advantage-number">04</div>
        <div class="advantage-text">
          <h3>Global replication with localized partners</h3>
        </div>
      </div>
      <div class="advantage-item">
        <div class="advantage-number">05</div>
        <div class="advantage-text">
          <h3>Mission-driven brand that attracts customers, partners, and capital</h3>
        </div>
      </div>
    </div>

    <div class="conclusion">
      <p>We are building infrastructure first.</p>
      <p class="accent">Revenue follows infrastructure.</p>
    </div>
  </div>
</section>

<style>
  .why-we-win {
    padding: 100px 24px;
  }

  .container {
    max-width: 800px;
    margin: 0 auto;
  }

  .section-title {
    font-size: clamp(24px, 3.5vw, 36px);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-white);
    text-align: center;
    margin-bottom: 60px;
  }

  .highlight {
    color: var(--color-primary);
  }

  .advantages {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-bottom: 60px;
  }

  .advantage-item {
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 24px 0;
    border-bottom: 1px solid rgba(255,255,255,0.06);
    transition: all 0.2s ease;
  }

  .advantage-item:first-child {
    border-top: 1px solid rgba(255,255,255,0.06);
  }

  .advantage-item:hover {
    padding-left: 12px;
  }

  .advantage-number {
    font-size: 13px;
    font-weight: 700;
    color: var(--color-primary);
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
    width: 32px;
  }

  .advantage-text h3 {
    font-size: 17px;
    font-weight: 500;
    color: rgba(255,255,255,0.85);
    line-height: 1.5;
  }

  .conclusion {
    text-align: center;
  }

  .conclusion p {
    font-size: 18px;
    font-weight: 600;
    color: rgba(255,255,255,0.6);
    margin-bottom: 8px;
  }

  .conclusion .accent {
    color: var(--color-primary);
    font-size: 20px;
  }

  @media (max-width: 768px) {
    .why-we-win {
      padding: 60px 20px;
    }
  }
</style>
