<section class="solution" id="solution-section">
  <div class="container">
    <span class="section-label">THE SOLUTION</span>
    <h2 class="section-heading">A Platform, Not a Contractor</h2>
    <p class="section-intro">
      Ancestro operates as a private international renewable energy and charging network, powered by a proprietary fintech layer that orchestrates every participant in the ecosystem.
    </p>

    <div class="stakeholder-grid">
      <div class="stakeholder-card" data-animate>
        <span class="card-number">01</span>
        <h3 class="card-name">Customers</h3>
        <p class="card-desc">Homeowners and businesses seeking energy independence through solar, storage, and EV charging — without the complexity.</p>
      </div>
      <div class="stakeholder-card" data-animate>
        <span class="card-number">02</span>
        <h3 class="card-name">Installers & EPCs</h3>
        <p class="card-desc">Certified installation partners seeking a steady pipeline of pre-qualified, pre-financed projects across markets.</p>
      </div>
      <div class="stakeholder-card" data-animate>
        <span class="card-number">03</span>
        <h3 class="card-name">Distributors & Dealerships</h3>
        <p class="card-desc">Equipment suppliers and channel partners seeking predictable demand and streamlined fulfillment at scale.</p>
      </div>
      <div class="stakeholder-card" data-animate>
        <span class="card-number">04</span>
        <h3 class="card-name">Investors</h3>
        <p class="card-desc">Capital allocators seeking scalable deployment into real-asset infrastructure with transparent, recurring yields.</p>
      </div>
    </div>

    <div class="benefits-row">
      <span class="benefit-pill">Capital-Light Expansion</span>
      <span class="benefit-pill">Rapid Geographic Replication</span>
      <span class="benefit-pill">Copy-Paste Market Entry</span>
      <span class="benefit-pill">Defensible Network Effects</span>
    </div>
  </div>
</section>

<style>
  .solution {
    padding: 64px 24px;
    position: relative;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-primary);
    text-align: center;
    margin-bottom: 16px;
  }

  .section-heading {
    font-size: 2.25rem;
    font-weight: 600;
    color: var(--color-white);
    text-align: center;
    letter-spacing: -0.02em;
    margin-bottom: 20px;
  }

  .section-intro {
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--color-gray);
    text-align: center;
    max-width: 680px;
    margin: 0 auto 40px;
  }

  /* ---- Stakeholder grid ---- */
  .stakeholder-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-bottom: 40px;
  }

  .stakeholder-card {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--color-white-10);
    border-radius: 12px;
    padding: 32px;
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.5s ease, transform 0.5s ease, border-color 0.3s ease;
  }

  .stakeholder-card.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .stakeholder-card:hover {
    border-color: rgba(248, 176, 59, 0.3);
  }

  .card-number {
    display: inline-block;
    font-family: "SF Mono", "Fira Code", "Cascadia Code", "Consolas", monospace;
    font-size: 14px;
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: 16px;
    letter-spacing: 0.04em;
  }

  .card-name {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-white);
    margin-bottom: 10px;
  }

  .card-desc {
    font-size: 0.925rem;
    line-height: 1.7;
    color: var(--color-gray);
  }

  /* ---- Benefit pills ---- */
  .benefits-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  .benefit-pill {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-primary);
    background: rgba(248, 176, 59, 0.08);
    border: 1px solid rgba(248, 176, 59, 0.18);
    border-radius: 100px;
    padding: 10px 22px;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  /* ---- Responsive ---- */
  @media (max-width: 768px) {
    .solution {
      padding: 40px 20px;
    }

    .section-heading {
      font-size: 1.75rem;
    }

    .stakeholder-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .benefits-row {
      flex-direction: column;
      align-items: center;
    }
  }
</style>

<script>
  function initSolutionObserver() {
    const cards = document.querySelectorAll('.stakeholder-card[data-animate]');
    if (!cards.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const card = entry.target as HTMLElement;
          const index = Array.from(cards).indexOf(card);
          setTimeout(() => {
            card.classList.add('visible');
          }, index * 100);
          observer.unobserve(card);
        });
      },
      { threshold: 0.15 }
    );

    cards.forEach((card) => observer.observe(card));
  }

  document.addEventListener('astro:page-load', initSolutionObserver);
  initSolutionObserver();
</script>
