---
---

<section class="solution">
  <div class="container">
    <div class="section-label">The Platform</div>
    <h2 class="section-title">Ancestro Is a Platform — <span class="highlight">Not a Contractor</span></h2>

    <p class="section-intro">
      Ancestro operates as a private international renewable energy and charging network, enabled by a proprietary fintech platform.
    </p>
    <p class="section-emphasis">We do not perform construction. We orchestrate the ecosystem.</p>

    <div class="connects-section">
      <h3 class="connects-title">Our platform connects:</h3>
      <div class="connects-grid">
        <div class="connect-card">
          <div class="connect-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
              <polyline points="9 22 9 12 15 12 15 22"/>
            </svg>
          </div>
          <h4>Customers</h4>
          <p>Seeking energy independence</p>
        </div>
        <div class="connect-card">
          <div class="connect-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
            </svg>
          </div>
          <h4>Installers & EPCs</h4>
          <p>Seeking projects</p>
        </div>
        <div class="connect-card">
          <div class="connect-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="1" y="3" width="15" height="13" rx="2"/>
              <path d="M16 8h4l3 3v5a1 1 0 0 1-1 1h-1"/>
              <circle cx="5.5" cy="18.5" r="2.5"/>
              <circle cx="18.5" cy="18.5" r="2.5"/>
            </svg>
          </div>
          <h4>Distributors & Dealerships</h4>
          <p>Seeking demand</p>
        </div>
        <div class="connect-card">
          <div class="connect-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
            </svg>
          </div>
          <h4>Investors</h4>
          <p>Seeking scalable deployment</p>
        </div>
      </div>
    </div>

    <p class="network-statement">Ancestro becomes the network layer — coordinating capital, projects, compliance, and fulfillment across markets.</p>

    <div class="model-benefits">
      <h3 class="benefits-title">This model allows:</h3>
      <div class="benefits-list">
        <div class="benefit-item">
          <span class="benefit-check">&#10003;</span>
          Capital-light expansion
        </div>
        <div class="benefit-item">
          <span class="benefit-check">&#10003;</span>
          Rapid geographic replication
        </div>
        <div class="benefit-item">
          <span class="benefit-check">&#10003;</span>
          Copy-paste market entry
        </div>
        <div class="benefit-item">
          <span class="benefit-check">&#10003;</span>
          Defensible network effects
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .solution {
    padding: 100px 24px;
    background: linear-gradient(180deg, transparent 0%, rgba(248,176,59,0.02) 50%, transparent 100%);
  }

  .container {
    max-width: 1000px;
    margin: 0 auto;
  }

  .section-label {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-primary);
    text-align: center;
    margin-bottom: 12px;
  }

  .section-title {
    font-size: clamp(24px, 3.5vw, 36px);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-white);
    text-align: center;
    margin-bottom: 24px;
  }

  .highlight {
    color: var(--color-primary);
  }

  .section-intro {
    font-size: 17px;
    color: rgba(255,255,255,0.7);
    text-align: center;
    max-width: 700px;
    margin: 0 auto 12px;
    line-height: 1.7;
  }

  .section-emphasis {
    font-size: 16px;
    font-weight: 600;
    color: var(--color-white);
    text-align: center;
    margin-bottom: 60px;
  }

  .connects-title {
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgba(255,255,255,0.5);
    margin-bottom: 24px;
    text-align: center;
  }

  .connects-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 48px;
  }

  .connect-card {
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 16px;
    padding: 28px 20px;
    text-align: center;
    transition: all 0.3s ease;
  }

  .connect-card:hover {
    border-color: rgba(248,176,59,0.25);
    transform: translateY(-4px);
  }

  .connect-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(248,176,59,0.1);
    border-radius: 12px;
    margin: 0 auto 16px;
    color: var(--color-primary);
  }

  .connect-card h4 {
    font-size: 15px;
    font-weight: 600;
    color: var(--color-white);
    margin-bottom: 6px;
  }

  .connect-card p {
    font-size: 13px;
    color: rgba(255,255,255,0.5);
  }

  .network-statement {
    font-size: 16px;
    color: rgba(255,255,255,0.6);
    text-align: center;
    margin-bottom: 48px;
    font-style: italic;
  }

  .benefits-title {
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgba(255,255,255,0.5);
    margin-bottom: 20px;
    text-align: center;
  }

  .benefits-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    max-width: 600px;
    margin: 0 auto;
  }

  .benefit-item {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 15px;
    color: rgba(255,255,255,0.8);
    padding: 14px 20px;
    background: rgba(255,255,255,0.03);
    border-radius: 12px;
    border: 1px solid rgba(255,255,255,0.06);
  }

  .benefit-check {
    color: var(--color-primary);
    font-weight: 700;
    font-size: 14px;
  }

  @media (max-width: 768px) {
    .solution {
      padding: 60px 20px;
    }

    .connects-grid {
      grid-template-columns: 1fr 1fr;
    }

    .benefits-list {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .connects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
