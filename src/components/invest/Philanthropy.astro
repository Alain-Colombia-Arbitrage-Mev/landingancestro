---
const initiatives = [
  {
    icon: "sun",
    name: "Free Solar for Communities",
    description: "Deploying off-grid solar installations to underserved communities across Latin America and beyond.",
  },
  {
    icon: "leaf",
    name: "Amazon Reforestation",
    description: "Funding large-scale native species reforestation and rainforest preservation programs.",
  },
  {
    icon: "waves",
    name: "Ocean Plastic Removal",
    description: "Partnering with cleanup organizations to actively remove plastic waste from ocean ecosystems.",
  },
];
---

<section class="philanthropy" id="philanthropy">
  <div class="container">
    <span class="label">IMPACT</span>
    <h2 class="heading">Profit With Purpose</h2>
    <p class="intro">
      Ancestro commits a minimum of <strong>5% of net profits</strong> to regenerative initiatives.
      Growth and responsibility are not competing priorities — they are the same priority.
    </p>

    <div class="initiatives-row">
      {initiatives.map((item, i) => (
        <div class="initiative-card" data-animate data-delay={i}>
          <span class="card-icon">
            {item.icon === "sun" && (
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="5"/>
                <line x1="12" y1="1" x2="12" y2="3"/>
                <line x1="12" y1="21" x2="12" y2="23"/>
                <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
                <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
                <line x1="1" y1="12" x2="3" y2="12"/>
                <line x1="21" y1="12" x2="23" y2="12"/>
                <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
                <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
              </svg>
            )}
            {item.icon === "leaf" && (
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M11 20A7 7 0 0 1 9.8 6.9C15.5 4.9 17 3.5 19 2c1 2 2 4.5 2 8 0 5.5-4.78 10-10 10Z"/>
                <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>
              </svg>
            )}
            {item.icon === "waves" && (
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2 6c.6.5 1.2 1 2.5 1C7 7 7 5 9.5 5c2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/>
                <path d="M2 12c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/>
                <path d="M2 18c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/>
              </svg>
            )}
          </span>
          <h3 class="card-name">{item.name}</h3>
          <p class="card-desc">{item.description}</p>
        </div>
      ))}
    </div>

    <blockquote class="closing-quote" data-animate data-delay={3}>
      Impact is not an afterthought. It is embedded into the operating model.
    </blockquote>
  </div>
</section>

<style>
  .philanthropy {
    padding: 64px 24px;
    background: var(--color-black);
    position: relative;
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
  }

  /* ── Label ── */
  .label {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: 16px;
  }

  /* ── Heading ── */
  .heading {
    font-size: 2.25rem;
    font-weight: 600;
    color: var(--color-white);
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin: 0 0 20px;
  }

  /* ── Intro ── */
  .intro {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--color-gray);
    max-width: 680px;
    margin: 0 0 32px;
  }

  .intro strong {
    color: var(--color-primary);
    font-weight: 600;
  }

  /* ── Card Row ── */
  .initiatives-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-bottom: 40px;
  }

  /* ── Card ── */
  .initiative-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--color-white-10);
    border-top: 2px solid var(--color-primary);
    border-radius: 12px;
    padding: 32px;
    transition: border-color 0.3s ease, transform 0.3s ease;
  }

  .initiative-card:hover {
    border-color: var(--color-white-20);
    border-top-color: var(--color-primary);
    transform: translateY(-2px);
  }

  .card-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: rgba(248, 176, 59, 0.1);
    color: var(--color-primary);
    margin-bottom: 16px;
  }

  .card-name {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-white);
    margin: 0 0 8px;
  }

  .card-desc {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-gray);
    margin: 0;
  }

  /* ── Closing Blockquote ── */
  .closing-quote {
    border-left: 3px solid var(--color-primary);
    padding: 0 0 0 24px;
    margin: 0;
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.6;
    color: var(--color-white);
    max-width: 700px;
    font-style: normal;
  }

  /* ── Animate ── */
  [data-animate] {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  [data-animate].visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .philanthropy {
      padding: 40px 20px;
    }

    .heading {
      font-size: 1.75rem;
    }

    .initiatives-row {
      grid-template-columns: 1fr;
      gap: 16px;
      margin-bottom: 28px;
    }

    .closing-quote {
      font-size: 1.1rem;
    }
  }
</style>

<script>
  function initPhilanthropy() {
    const elements = document.querySelectorAll('#philanthropy [data-animate]');
    if (!elements.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const delay = Number(entry.target.dataset.delay) || 0;
            setTimeout(() => {
              entry.target.classList.add('visible');
            }, delay * 120);
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 }
    );

    elements.forEach((el) => observer.observe(el));
  }

  document.addEventListener('DOMContentLoaded', initPhilanthropy);
  document.addEventListener('astro:page-load', initPhilanthropy);
</script>
