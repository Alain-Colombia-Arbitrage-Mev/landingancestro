---
interface Props {
  sharePrice: string;
  valuation: string;
}

const { sharePrice, valuation } = Astro.props;
---

<section class="final-cta">
  <div class="final-cta__glow"></div>
  <div class="final-cta__inner">

    <div class="final-cta__statements">
      <p class="final-cta__line" data-delay="0">The platform is built.</p>
      <p class="final-cta__line" data-delay="1">The markets are opening.</p>
      <p class="final-cta__line" data-delay="2">The network is forming.</p>
    </div>

    <div class="final-cta__divider" data-delay="3"></div>

    <p class="final-cta__declaration" data-delay="3">
      Ancestro is not asking if the future is coming.<br />We are building it.
    </p>

    <div class="final-cta__actions" data-delay="4">
      <a href="#buy-stock" class="final-cta__btn final-cta__btn--primary">
        Buy Ancestro Stock
      </a>
      <a
        href="https://calendly.com"
        target="_blank"
        rel="noopener noreferrer"
        class="final-cta__btn final-cta__btn--secondary"
      >
        Schedule a Private Call
      </a>
    </div>

    <p class="final-cta__meta" data-delay="5">
      {sharePrice} per share &middot; {valuation} valuation
    </p>

  </div>
</section>

<style>
  /* ─── Section ─── */
  .final-cta {
    position: relative;
    overflow: hidden;
    padding: 80px 24px 56px;
    text-align: center;
  }

  /* ─── Radial gold glow ─── */
  .final-cta__glow {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    max-width: 1200px;
    height: 520px;
    background: radial-gradient(
      ellipse 80% 55% at 50% 0%,
      rgba(248, 176, 59, 0.08) 0%,
      transparent 100%
    );
    pointer-events: none;
  }

  /* ─── Container ─── */
  .final-cta__inner {
    position: relative;
    z-index: 1;
    max-width: 800px;
    margin: 0 auto;
  }

  /* ─── Stacked statements ─── */
  .final-cta__statements {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 32px;
  }

  .final-cta__line {
    font-size: 1.5rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.72);
    letter-spacing: -0.01em;
    line-height: 1.4;
    margin: 0;
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .final-cta__line.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ─── Gold divider line ─── */
  .final-cta__divider {
    width: 40px;
    height: 2px;
    background: var(--color-primary);
    margin: 0 auto 32px;
    opacity: 0;
    transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .final-cta__divider.is-visible {
    opacity: 1;
  }

  /* ─── Bold declaration ─── */
  .final-cta__declaration {
    font-size: 2rem;
    font-weight: 600;
    color: var(--color-primary);
    line-height: 1.35;
    letter-spacing: -0.015em;
    margin: 0 0 32px;
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .final-cta__declaration.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ─── CTA buttons row ─── */
  .final-cta__actions {
    display: flex;
    justify-content: center;
    gap: 16px;
    margin-bottom: 28px;
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .final-cta__actions.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Shared button base */
  .final-cta__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 36px;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    border-radius: 14px;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.25s ease,
                border-color 0.25s ease,
                box-shadow 0.25s ease,
                transform 0.25s ease;
  }

  /* Primary - gold bg */
  .final-cta__btn--primary {
    background: var(--color-primary);
    color: var(--color-black);
    border: 2px solid var(--color-primary);
  }

  .final-cta__btn--primary:hover {
    background: #ffbe4d;
    border-color: #ffbe4d;
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(248, 176, 59, 0.3);
  }

  /* Secondary - glass border */
  .final-cta__btn--secondary {
    background: rgba(255, 255, 255, 0.04);
    color: rgba(255, 255, 255, 0.82);
    border: 1.5px solid var(--color-white-20);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .final-cta__btn--secondary:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.32);
    color: var(--color-white);
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(255, 255, 255, 0.06);
  }

  /* ─── Meta line ─── */
  .final-cta__meta {
    font-size: 0.85rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.45);
    letter-spacing: 0.01em;
    margin: 0;
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .final-cta__meta.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ─── Responsive ─── */
  @media (max-width: 640px) {
    .final-cta {
      padding: 56px 20px 40px;
    }

    .final-cta__line {
      font-size: 1.25rem;
    }

    .final-cta__declaration {
      font-size: 1.55rem;
      margin-bottom: 44px;
    }

    .final-cta__actions {
      flex-direction: column;
      align-items: center;
    }

    .final-cta__btn {
      width: 100%;
      max-width: 340px;
    }
  }
</style>

<script>
  function initFinalCTA() {
    const section = document.querySelector('.final-cta');
    if (!section) return;

    const animated = section.querySelectorAll<HTMLElement>('[data-delay]');
    if (!animated.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;

          animated.forEach((el) => {
            const delay = parseInt(el.dataset.delay || '0', 10);
            setTimeout(() => {
              el.classList.add('is-visible');
            }, delay * 180);
          });

          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.2 }
    );

    observer.observe(section);
  }

  // Run on initial load and on Astro page transitions
  document.addEventListener('astro:page-load', initFinalCTA);
  initFinalCTA();
</script>
