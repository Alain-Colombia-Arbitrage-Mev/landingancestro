<section class="active-passive" id="participation">
  <div class="container">
    <span class="section-label">PARTICIPATION</span>
    <h2 class="section-heading">Choose Your Path</h2>

    <div class="cards-grid">
      <!-- Passive Card -->
      <div class="card card--passive" data-animate>
        <div class="card__header">
          <h3 class="card__title">Passive</h3>
          <p class="card__subtitle">Capital Allocation</p>
        </div>
        <ul class="card__features">
          <li>
            <svg class="check-icon" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M3 8.5L6.5 12L13 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>Capital allocation</span>
          </li>
          <li>
            <svg class="check-icon" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M3 8.5L6.5 12L13 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>Quarterly investor updates</span>
          </li>
          <li>
            <svg class="check-icon" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M3 8.5L6.5 12L13 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>Investor dashboard access</span>
          </li>
          <li>
            <svg class="check-icon" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M3 8.5L6.5 12L13 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>SAFE agreement protection</span>
          </li>
        </ul>
      </div>

      <!-- Active Card (Featured) -->
      <div class="card card--active" data-animate>
        <div class="card__badge">Recommended</div>
        <div class="card__header">
          <h3 class="card__title">Active</h3>
          <p class="card__subtitle">Strategic Partnership</p>
        </div>
        <ul class="card__features">
          <li>
            <svg class="check-icon" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M3 8.5L6.5 12L13 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>Strategic partnership</span>
          </li>
          <li>
            <svg class="check-icon" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M3 8.5L6.5 12L13 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>Advisory opportunities</span>
          </li>
          <li>
            <svg class="check-icon" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M3 8.5L6.5 12L13 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>Network introductions</span>
          </li>
          <li>
            <svg class="check-icon" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M3 8.5L6.5 12L13 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>Co-development pathways</span>
          </li>
          <li>
            <svg class="check-icon" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M3 8.5L6.5 12L13 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>Early access to new verticals</span>
          </li>
        </ul>
      </div>
    </div>

    <div class="cta-area" data-animate>
      <a href="#contact" class="cta-button">Request Access to Invest</a>
      <p class="contact-line">
        Questions? Reach us at
        <a href="mailto:invest@ancestro.com" class="email-link">invest@ancestro.com</a>
      </p>
    </div>
  </div>
</section>

<style>
  .active-passive {
    padding: 64px 24px;
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .section-label {
    display: block;
    text-align: center;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-primary);
    margin-bottom: 16px;
  }

  .section-heading {
    font-size: 2.25rem;
    font-weight: 600;
    color: var(--color-white);
    text-align: center;
    letter-spacing: -0.02em;
    margin-bottom: 32px;
  }

  /* ---- Cards Grid ---- */
  .cards-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
    margin-bottom: 40px;
  }

  /* ---- Base Card ---- */
  .card {
    position: relative;
    border-radius: 12px;
    padding: 40px;
    transition: border-color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
    opacity: 0;
    transform: translateY(24px);
  }

  .card.is-visible {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.6s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.3s ease,
                box-shadow 0.3s ease;
  }

  /* ---- Passive Card ---- */
  .card--passive {
    background: transparent;
    border: 1px solid var(--color-white-10);
  }

  .card--passive:hover {
    border-color: var(--color-white-20);
  }

  /* ---- Active Card (Featured) ---- */
  .card--active {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--color-white-10);
    border-top: 3px solid var(--color-primary);
    padding-top: 56px;
  }

  .card--active:hover {
    border-color: var(--color-white-20);
    border-top-color: var(--color-primary);
    box-shadow: 0 8px 40px rgba(248, 176, 59, 0.06);
  }

  /* ---- Badge ---- */
  .card__badge {
    position: absolute;
    top: 20px;
    right: 20px;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-primary);
    background: rgba(248, 176, 59, 0.1);
    border: 1px solid rgba(248, 176, 59, 0.2);
    padding: 4px 12px;
    border-radius: 100px;
    line-height: 1.4;
  }

  /* ---- Card Header ---- */
  .card__header {
    margin-bottom: 28px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--color-white-10);
  }

  .card__title {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 8px;
  }

  .card--passive .card__title {
    color: var(--color-gray);
  }

  .card--active .card__title {
    color: var(--color-primary);
  }

  .card__subtitle {
    font-size: 22px;
    font-weight: 600;
    color: var(--color-white);
    letter-spacing: -0.01em;
  }

  /* ---- Feature List ---- */
  .card__features {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .card__features li {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 15px;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.5;
  }

  .check-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  .card--passive .check-icon {
    color: rgba(255, 255, 255, 0.5);
  }

  .card--active .check-icon {
    color: var(--color-primary);
  }

  /* ---- CTA Area ---- */
  .cta-area {
    text-align: center;
    opacity: 0;
    transform: translateY(24px);
  }

  .cta-area.is-visible {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.15s,
                transform 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.15s;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 48px;
    background: var(--color-primary);
    color: var(--color-black);
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.01em;
    border-radius: 12px;
    text-decoration: none;
    transition: background 0.3s ease, transform 0.2s ease, box-shadow 0.3s ease;
    margin-bottom: 20px;
  }

  .cta-button:hover {
    background: #ffbe4d;
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(248, 176, 59, 0.3);
  }

  .cta-button:active {
    transform: translateY(0);
  }

  .contact-line {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.35);
  }

  .email-link {
    color: rgba(255, 255, 255, 0.5);
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
    padding-bottom: 1px;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .email-link:hover {
    color: var(--color-primary);
    border-bottom-color: var(--color-primary);
  }

  /* ---- Stagger animation for cards ---- */
  .card:nth-child(2).is-visible {
    transition-delay: 0.1s;
  }

  /* ---- Responsive ---- */
  @media (max-width: 768px) {
    .active-passive {
      padding: 40px 20px 60px;
    }

    .section-heading {
      font-size: 1.75rem;
      margin-bottom: 40px;
    }

    .cards-grid {
      grid-template-columns: 1fr;
      gap: 20px;
      margin-bottom: 28px;
    }

    .card {
      padding: 32px 28px;
    }

    .card__badge {
      top: 16px;
      right: 16px;
    }

    .cta-button {
      width: 100%;
      padding: 16px 32px;
    }
  }
</style>

<script>
  function initActivePassive() {
    const section = document.querySelector('#participation');
    if (!section) return;

    const animatedEls = section.querySelectorAll('[data-animate]');
    if (!animatedEls.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 }
    );

    animatedEls.forEach((el) => observer.observe(el));
  }

  document.addEventListener('DOMContentLoaded', initActivePassive);
  document.addEventListener('astro:page-load', initActivePassive);
  initActivePassive();
</script>
