---
interface Props {
  variant: 'hero' | 'bottom';
}

const { variant } = Astro.props;
const isHero = variant === 'hero';

const heading = isHero
  ? 'The Investor Deck'
  : 'Ready to Explore Further?';

const description = isHero
  ? 'A comprehensive overview of the Ancestro platform — market thesis, product architecture, financial model, and the team building it.'
  : 'Dive into the detailed analysis behind our strategy, unit economics, competitive landscape, and long-term roadmap.';
---

<section
  class:list={['investor-deck', `investor-deck--${variant}`]}
  id={isHero ? 'deck' : 'deck-bottom'}
  data-animate
>
  <div class="investor-deck__container">
    <div class="investor-deck__card">

      <div class="investor-deck__visual">
        <div class="investor-deck__mockup">
          <div class="mockup__slide">
            <div class="mockup__line mockup__line--title"></div>
            <div class="mockup__line mockup__line--subtitle"></div>
            <div class="mockup__spacer"></div>
            <div class="mockup__line mockup__line--body"></div>
            <div class="mockup__line mockup__line--body mockup__line--short"></div>
            <div class="mockup__spacer"></div>
            <div class="mockup__row">
              <div class="mockup__block"></div>
              <div class="mockup__block"></div>
              <div class="mockup__block"></div>
            </div>
          </div>
          <button class="mockup__play" aria-label="Play investor deck">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
              <path d="M8 5.14v13.72a1 1 0 0 0 1.5.86l11.04-6.86a1 1 0 0 0 0-1.72L9.5 4.28a1 1 0 0 0-1.5.86z" fill="currentColor"/>
            </svg>
          </button>
        </div>
      </div>

      <div class="investor-deck__content">
        <h3 class="investor-deck__heading">{heading}</h3>
        <p class="investor-deck__description">{description}</p>
        <a href="#deck" class="investor-deck__cta">
          <span>Explore the Ancestro Vision</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="12 5 19 12 12 19"/>
          </svg>
        </a>
      </div>

    </div>
  </div>
</section>

<style>
  /* ── Layout ── */
  .investor-deck {
    padding: 48px 24px;
  }

  .investor-deck--bottom {
    padding: 32px 24px 48px;
  }

  .investor-deck__container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .investor-deck__card {
    display: flex;
    align-items: stretch;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--color-white-10);
    border-radius: 16px;
    overflow: hidden;
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s ease, transform 0.6s ease, border-color 0.3s ease;
  }

  .investor-deck__card:hover {
    border-color: var(--color-white-20);
  }

  [data-animate].is-visible .investor-deck__card {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── Visual / Mockup Side ── */
  .investor-deck__visual {
    flex: 0 0 44%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 48px 40px;
    position: relative;
  }

  .investor-deck__mockup {
    position: relative;
    width: 100%;
    max-width: 340px;
    aspect-ratio: 16 / 10;
    border: 1px solid rgba(248, 176, 59, 0.12);
    border-radius: 8px;
    background: rgba(30, 22, 8, 0.45);
    padding: 24px 28px;
    display: flex;
    flex-direction: column;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
    box-shadow: 0 0 0 1px rgba(248, 176, 59, 0.05), 0 0 24px rgba(248, 176, 59, 0.04);
  }

  .investor-deck__card:hover .investor-deck__mockup {
    border-color: rgba(248, 176, 59, 0.25);
    box-shadow: 0 0 0 1px rgba(248, 176, 59, 0.08), 0 0 32px rgba(248, 176, 59, 0.07);
  }

  .mockup__slide {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .mockup__line {
    border-radius: 2px;
    background: var(--color-white-10);
  }

  .mockup__line--title {
    height: 8px;
    width: 55%;
    margin-bottom: 8px;
    background: rgba(248, 176, 59, 0.25);
  }

  .mockup__line--subtitle {
    height: 5px;
    width: 38%;
    margin-bottom: 0;
  }

  .mockup__line--body {
    height: 4px;
    width: 80%;
    margin-bottom: 6px;
  }

  .mockup__line--short {
    width: 52%;
  }

  .mockup__spacer {
    flex: 1;
    min-height: 10px;
  }

  .mockup__row {
    display: flex;
    gap: 8px;
  }

  .mockup__block {
    flex: 1;
    height: 28px;
    border-radius: 3px;
    border: 1px solid var(--color-white-10);
    background: rgba(255, 255, 255, 0.02);
  }

  /* Play overlay */
  .mockup__play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--color-white);
    opacity: 0.7;
    transition: opacity 0.3s ease;
  }

  .mockup__play svg {
    width: 40px;
    height: 40px;
    padding: 10px;
    border-radius: 50%;
    background: rgba(248, 176, 59, 0.15);
    border: 1px solid rgba(248, 176, 59, 0.3);
    transition: background 0.25s ease, transform 0.25s ease;
  }

  .investor-deck__mockup:hover .mockup__play {
    opacity: 1.0;
  }

  .mockup__play:hover svg {
    background: rgba(248, 176, 59, 0.25);
    transform: scale(1.08);
  }

  /* ── Content Side ── */
  .investor-deck__content {
    flex: 1;
    padding: 48px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 16px;
  }

  .investor-deck__heading {
    font-size: 28px;
    font-weight: 700;
    color: var(--color-white);
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .investor-deck__description {
    font-size: 15px;
    color: var(--color-gray);
    line-height: 1.7;
    margin: 0;
    max-width: 440px;
  }

  .investor-deck__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
    color: var(--color-primary);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    transition: gap 0.25s ease;
    align-self: flex-start;
  }

  .investor-deck__cta span {
    background-image: linear-gradient(currentColor, currentColor);
    background-position: 0% 100%;
    background-repeat: no-repeat;
    background-size: 0% 1px;
    transition: background-size 0.3s ease;
    padding-bottom: 2px;
  }

  .investor-deck__cta:hover span {
    background-size: 100% 1px;
  }

  .investor-deck__cta:hover {
    gap: 12px;
  }

  .investor-deck__cta svg {
    transition: transform 0.25s ease;
  }

  .investor-deck__cta:hover svg {
    transform: translateX(2px);
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .investor-deck {
      padding: 32px 20px;
    }

    .investor-deck--bottom {
      padding: 20px 20px 40px;
    }

    .investor-deck__card {
      flex-direction: column;
    }

    .investor-deck__visual {
      flex: none;
      padding: 32px 28px;
    }

    .investor-deck__mockup {
      max-width: 280px;
    }

    .mockup__play {
      opacity: 1;
    }

    .investor-deck__content {
      padding: 32px 28px 40px;
    }

    .investor-deck__heading {
      font-size: 22px;
    }

    .investor-deck__description {
      font-size: 14px;
    }
  }
</style>

<script>
  function initInvestorDeck() {
    const sections = document.querySelectorAll<HTMLElement>('[data-animate]');
    if (!sections.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 }
    );

    sections.forEach((el) => observer.observe(el));
  }

  document.addEventListener('astro:page-load', initInvestorDeck);
  initInvestorDeck();
</script>
