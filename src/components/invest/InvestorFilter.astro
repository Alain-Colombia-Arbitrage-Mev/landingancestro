<section class="investor-filter" id="investor-filter">
  <div class="investor-filter__container">

    <h2 class="investor-filter__heading">
      This Is Not a Conventional Investment
    </h2>

    <div class="investor-filter__intro">
      <p>
        Ancestro is designed for long-term thinkers — capital allocators who
        understand that the most consequential systems in history were built
        before the market recognized their value. We are looking for partners,
        not speculators.
      </p>
    </div>

    <div class="investor-filter__body">
      <p class="investor-filter__label">Our investors are typically:</p>

      <ul class="investor-filter__traits">
        <li class="investor-filter__trait">
          <span class="investor-filter__bullet" aria-hidden="true"></span>
          American and European capital allocators with a global thesis
        </li>
        <li class="investor-filter__trait">
          <span class="investor-filter__bullet" aria-hidden="true"></span>
          Comfortable with early-stage, pre-revenue ventures
        </li>
        <li class="investor-filter__trait">
          <span class="investor-filter__bullet" aria-hidden="true"></span>
          Spiritually curious, health-conscious, and globally minded
        </li>
        <li class="investor-filter__trait">
          <span class="investor-filter__bullet" aria-hidden="true"></span>
          Interested in legacy, impact, and asymmetric upside
        </li>
        <li class="investor-filter__trait">
          <span class="investor-filter__bullet" aria-hidden="true"></span>
          Aligned with long-term value creation over short-term exits
        </li>
      </ul>
    </div>

    <footer class="investor-filter__closing">
      <p>
        This is not a quick flip. This is the construction of a global system
        — one that connects ancestral wisdom with modern technology at scale.
      </p>
    </footer>

  </div>
</section>

<style>
  .investor-filter {
    padding: 48px 24px;
    position: relative;
  }

  .investor-filter__container {
    max-width: 900px;
    margin: 0 auto;
  }

  /* ---- Heading ---- */
  .investor-filter__heading {
    font-size: 2.25rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--color-white);
    margin: 0 0 28px;
  }

  /* ---- Intro blockquote-style paragraph ---- */
  .investor-filter__intro {
    border-left: 3px solid var(--color-primary);
    padding-left: 24px;
    margin-bottom: 28px;
  }

  .investor-filter__intro p {
    font-size: 1.125rem;
    font-weight: 400;
    line-height: 1.75;
    color: var(--color-gray);
    margin: 0;
  }

  /* ---- Body / traits ---- */
  .investor-filter__body {
    margin-bottom: 32px;
  }

  .investor-filter__label {
    font-size: 0.8125rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-white-20);
    margin: 0 0 28px;
  }

  .investor-filter__traits {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .investor-filter__trait {
    display: flex;
    align-items: baseline;
    gap: 16px;
    font-size: 1.125rem;
    font-weight: 400;
    line-height: 1.6;
    color: var(--color-gray);
  }

  .investor-filter__bullet {
    flex-shrink: 0;
    position: relative;
    top: 1px;
    display: inline-block;
    width: 20px;
    height: 2px;
    background: var(--color-primary);
    border-radius: 1px;
  }

  /* ---- Closing statement ---- */
  .investor-filter__closing {
    padding-top: 28px;
    border-top: 1px solid var(--color-white-10);
  }

  .investor-filter__closing p {
    font-size: 1.25rem;
    font-weight: 400;
    font-style: italic;
    line-height: 1.7;
    color: var(--color-white);
    margin: 0;
  }

  /* ---- Fade-in animation ---- */
  .investor-filter__heading,
  .investor-filter__intro,
  .investor-filter__body,
  .investor-filter__closing {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }

  .investor-filter__heading.visible,
  .investor-filter__intro.visible,
  .investor-filter__body.visible,
  .investor-filter__closing.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ---- Responsive ---- */
  @media (max-width: 768px) {
    .investor-filter {
      padding: 32px 20px;
    }

    .investor-filter__heading {
      font-size: 1.75rem;
      margin-bottom: 36px;
    }

    .investor-filter__intro {
      padding-left: 20px;
      margin-bottom: 36px;
    }

    .investor-filter__intro p {
      font-size: 1rem;
    }

    .investor-filter__body {
      margin-bottom: 24px;
    }

    .investor-filter__trait {
      font-size: 1rem;
      gap: 14px;
    }

    .investor-filter__bullet {
      width: 16px;
    }

    .investor-filter__closing {
      padding-top: 36px;
    }

    .investor-filter__closing p {
      font-size: 1.125rem;
    }
  }
</style>

<script is:inline>
  (function () {
    const section = document.getElementById('investor-filter');
    if (!section) return;

    const targets = section.querySelectorAll(
      '.investor-filter__heading, .investor-filter__intro, .investor-filter__body, .investor-filter__closing'
    );

    var observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
    );

    targets.forEach(function (el, i) {
      el.style.transitionDelay = (i * 0.12) + 's';
      observer.observe(el);
    });
  })();
</script>
