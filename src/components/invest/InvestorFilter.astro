<section class="investor-filter">
  <div class="container">
    <h2 class="section-title">This Is Not a Conventional Investment</h2>

    <div class="filter-content">
      <p class="intro">Ancestro is for long-term thinkers.</p>
      <p class="label">Our investors are typically:</p>

      <ul class="investor-traits">
        <li>
          <span class="trait-icon"></span>
          American and European capital allocators
        </li>
        <li>
          <span class="trait-icon"></span>
          Comfortable with early-stage, pre-revenue ventures
        </li>
        <li>
          <span class="trait-icon"></span>
          Spiritually curious, health-conscious, globally minded
        </li>
        <li>
          <span class="trait-icon"></span>
          Interested in legacy, impact, and asymmetric upside
        </li>
        <li>
          <span class="trait-icon"></span>
          Aligned with long-term value creation over short-term exits
        </li>
      </ul>

      <div class="filter-footer">
        <p class="bold-line">This is not a quick flip.</p>
        <p class="bold-line accent">This is the construction of a global system.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .investor-filter {
    padding: 100px 24px;
    position: relative;
  }

  .container {
    max-width: 800px;
    margin: 0 auto;
  }

  .section-title {
    font-size: clamp(24px, 3.5vw, 36px);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-white);
    margin-bottom: 40px;
    text-align: center;
  }

  .filter-content {
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 20px;
    padding: 48px;
  }

  .intro {
    font-size: 20px;
    font-weight: 600;
    color: var(--color-white);
    margin-bottom: 24px;
  }

  .label {
    font-size: 15px;
    color: rgba(255,255,255,0.5);
    margin-bottom: 20px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 500;
  }

  .investor-traits {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 36px;
  }

  .investor-traits li {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 16px;
    color: rgba(255,255,255,0.8);
    line-height: 1.5;
  }

  .trait-icon {
    flex-shrink: 0;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-primary);
  }

  .filter-footer {
    padding-top: 32px;
    border-top: 1px solid rgba(255,255,255,0.08);
  }

  .bold-line {
    font-size: 18px;
    font-weight: 600;
    color: rgba(255,255,255,0.6);
    margin-bottom: 8px;
  }

  .bold-line.accent {
    color: var(--color-primary);
    margin-bottom: 0;
  }

  @media (max-width: 768px) {
    .investor-filter {
      padding: 60px 20px;
    }

    .filter-content {
      padding: 32px 24px;
    }
  }
</style>
