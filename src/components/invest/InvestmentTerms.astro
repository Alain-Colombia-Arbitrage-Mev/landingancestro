---
interface Props {
  sharePrice: string;
  valuation: string;
}

const { sharePrice, valuation } = Astro.props;
---

<section class="investment-terms" id="buy-stock">
  <div class="container">
    <h2 class="section-title">Investment <span class="highlight">Opportunity</span></h2>

    <div class="terms-card">
      <div class="terms-grid">
        <div class="term">
          <span class="term-label">Entity</span>
          <span class="term-value">Delaware C-Corporation: Ancestro Inc.</span>
        </div>
        <div class="term">
          <span class="term-label">Instrument</span>
          <span class="term-value">SAFE agreement</span>
        </div>
        <div class="term">
          <span class="term-label">Price</span>
          <span class="term-value primary">{sharePrice} per share</span>
        </div>
        <div class="term">
          <span class="term-label">Valuation</span>
          <span class="term-value primary">{valuation}</span>
        </div>
        <div class="term">
          <span class="term-label">Fund Transfer</span>
          <span class="term-value">Wired to U.S. bank account</span>
        </div>
        <div class="term">
          <span class="term-label">Profile</span>
          <span class="term-value">Early-stage, high-asymmetry</span>
        </div>
      </div>

      <div class="terms-cta">
        <a href="#contact" class="cta-buy">
          Buy Ancestro Stock
        </a>
        <p class="terms-note">{sharePrice} per share · {valuation} valuation · SAFE (Delaware C-Corp)</p>
      </div>
    </div>
  </div>
</section>

<style>
  .investment-terms {
    padding: 100px 24px;
    background: linear-gradient(180deg, transparent 0%, rgba(248,176,59,0.03) 50%, transparent 100%);
  }

  .container {
    max-width: 800px;
    margin: 0 auto;
  }

  .section-title {
    font-size: clamp(24px, 3.5vw, 36px);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-white);
    text-align: center;
    margin-bottom: 48px;
  }

  .highlight {
    color: var(--color-primary);
  }

  .terms-card {
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 24px;
    overflow: hidden;
  }

  .terms-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
  }

  .term {
    padding: 24px 32px;
    border-bottom: 1px solid rgba(255,255,255,0.06);
    border-right: 1px solid rgba(255,255,255,0.06);
  }

  .term:nth-child(even) {
    border-right: none;
  }

  .term:nth-last-child(-n+2) {
    border-bottom: none;
  }

  .term-label {
    display: block;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(255,255,255,0.4);
    margin-bottom: 8px;
  }

  .term-value {
    font-size: 16px;
    font-weight: 500;
    color: rgba(255,255,255,0.85);
  }

  .term-value.primary {
    color: var(--color-primary);
    font-weight: 700;
  }

  .terms-cta {
    padding: 32px;
    text-align: center;
    border-top: 1px solid rgba(255,255,255,0.06);
    background: rgba(248,176,59,0.03);
  }

  .cta-buy {
    display: inline-flex;
    align-items: center;
    padding: 16px 48px;
    background: var(--color-primary);
    color: var(--color-black);
    font-size: 18px;
    font-weight: 700;
    border-radius: 14px;
    text-decoration: none;
    transition: all 0.3s ease;
    margin-bottom: 12px;
  }

  .cta-buy:hover {
    background: #ffbe4d;
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(248,176,59,0.35);
  }

  .terms-note {
    font-size: 13px;
    color: rgba(255,255,255,0.4);
  }

  @media (max-width: 768px) {
    .investment-terms {
      padding: 60px 20px;
    }

    .terms-grid {
      grid-template-columns: 1fr;
    }

    .term {
      border-right: none !important;
      padding: 20px 24px;
    }

    .term:nth-last-child(-n+2) {
      border-bottom: 1px solid rgba(255,255,255,0.06);
    }

    .term:last-child {
      border-bottom: none;
    }

    .terms-cta {
      padding: 24px 20px;
    }

    .cta-buy {
      width: 100%;
      justify-content: center;
      font-size: 16px;
      padding: 14px 32px;
    }
  }
</style>
