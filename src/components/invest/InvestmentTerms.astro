---
interface Props {
  sharePrice: string;
  valuation: string;
}

const { sharePrice, valuation } = Astro.props;
---

<section class="investment-terms" id="buy-stock">
  <div class="terms-container">
    <span class="terms-label">TERMS</span>
    <h2 class="terms-heading">Investment Structure</h2>

    <div class="terms-grid">
      <div class="term-box">
        <span class="term-key">Entity</span>
        <span class="term-val">Delaware C-Corporation</span>
      </div>
      <div class="term-box">
        <span class="term-key">Instrument</span>
        <span class="term-val">SAFE agreement</span>
      </div>
      <div class="term-box">
        <span class="term-key">Share Price</span>
        <span class="term-val term-val--gold">{sharePrice}</span>
      </div>
      <div class="term-box">
        <span class="term-key">Valuation</span>
        <span class="term-val term-val--gold">{valuation}</span>
      </div>
      <div class="term-box">
        <span class="term-key">Fund Transfer</span>
        <span class="term-val">Wired to U.S. bank account</span>
      </div>
      <div class="term-box">
        <span class="term-key">Profile</span>
        <span class="term-val">Early-stage, high-asymmetry</span>
      </div>
    </div>

    <div class="terms-action">
      <a href="#contact" class="terms-cta">Buy Ancestro Stock</a>
    </div>
  </div>
</section>

<style>
  .investment-terms {
    padding: 64px 24px;
  }

  .terms-container {
    max-width: 900px;
    margin: 0 auto;
    opacity: 0;
    transform: translateY(32px);
    transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .terms-container.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .terms-label {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: 16px;
    text-align: center;
  }

  .terms-heading {
    font-size: 2.25rem;
    font-weight: 600;
    color: var(--color-white);
    text-align: center;
    margin: 0 0 32px;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .terms-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--color-white-10);
  }

  .term-box {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 24px;
    background: var(--color-black);
  }

  .term-key {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-gray);
    line-height: 1;
  }

  .term-val {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-white);
    line-height: 1.3;
  }

  .term-val--gold {
    color: var(--color-primary);
    font-variant-numeric: tabular-nums;
  }


  .terms-action {
    display: flex;
    justify-content: center;
    margin-top: 32px;
  }

  .terms-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 48px;
    background: var(--color-primary);
    color: var(--color-black);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    border-radius: 12px;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .terms-cta:hover {
    background: #ffbe4d;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(248, 176, 59, 0.3);
  }

  .terms-cta:active {
    transform: translateY(0);
  }

  @media (max-width: 640px) {
    .investment-terms {
      padding: 40px 20px;
    }

    .terms-heading {
      font-size: 1.75rem;
      margin-bottom: 40px;
    }

    .terms-grid {
      grid-template-columns: 1fr;
    }

    .terms-action {
      margin-top: 40px;
    }

    .terms-cta {
      width: 100%;
      padding: 16px 32px;
    }
  }
</style>

<script>
  const container = document.querySelector('.terms-container');
  if (container) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            container.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 }
    );
    observer.observe(container);
  }
</script>
