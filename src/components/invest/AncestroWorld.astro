---
const offerings = [
  {
    title: "Internal Social Platform",
    description: "Private network for learning, mentorship, and connection across the global community.",
  },
  {
    title: "Ancestral Health Education",
    description: "Longevity protocols and nutrition practices rooted in ancestral wisdom.",
  },
  {
    title: "Consciousness Practices",
    description: "Guided breathwork, meditation, and awareness-expanding frameworks.",
  },
  {
    title: "Eco-Resorts Access",
    description: "Regenerative retreat stays at Ancestro-owned and affiliate locations worldwide.",
  },
  {
    title: "Rituals & Gatherings",
    description: "Seasonal ceremonies and member-only events across continents.",
  },
  {
    title: "Community Experiences",
    description: "Immersive group journeys designed to deepen bonds and shared purpose.",
  },
];
---

<section class="aw" id="ancestro-world">
  <div class="aw__inner">

    <span class="aw__label">Beyond Energy</span>

    <h2 class="aw__heading">The Ancestro World</h2>

    <p class="aw__subtitle">
      Ancestro is more than a company. It is a modern tribe built on
      <strong>Energy Independence</strong>, <strong>Personal Sovereignty</strong>,
      <strong>Health</strong>, <strong>Purpose</strong> &amp; <strong>Awakening</strong>.
      Every participant in the ecosystem — customer, partner, or investor — is
      invited into a broader regenerative lifestyle framework.
    </p>

    <div class="aw__grid">
      {offerings.map((item) => (
        <div class="aw__card">
          <h3 class="aw__card-title">{item.title}</h3>
          <p class="aw__card-desc">{item.description}</p>
        </div>
      ))}
    </div>

    <p class="aw__closing">Many who enter Ancestro do not leave unchanged.</p>

  </div>
</section>

<style>
  /* ── Section ─────────────────────────────────────────────── */
  .aw {
    position: relative;
    padding: 64px 24px;
    background: linear-gradient(
      180deg,
      transparent 0%,
      rgba(248, 176, 59, 0.025) 50%,
      transparent 100%
    );
  }

  .aw__inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* ── Label ───────────────────────────────────────────────── */
  .aw__label {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-primary);
    margin-bottom: 16px;
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  /* ── Heading ─────────────────────────────────────────────── */
  .aw__heading {
    font-size: 2.25rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-white);
    text-align: center;
    margin-bottom: 20px;
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.6s ease 0.08s, transform 0.6s ease 0.08s;
  }

  /* ── Subtitle ────────────────────────────────────────────── */
  .aw__subtitle {
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--color-gray);
    text-align: center;
    max-width: 720px;
    margin-bottom: 40px;
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.6s ease 0.16s, transform 0.6s ease 0.16s;
  }

  .aw__subtitle strong {
    color: var(--color-white);
    font-weight: 600;
  }

  /* ── Grid ────────────────────────────────────────────────── */
  .aw__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    width: 100%;
    margin-bottom: 72px;
  }

  /* ── Card ────────────────────────────────────────────────── */
  .aw__card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--color-white-10);
    border-radius: 12px;
    padding: 28px;
    opacity: 0;
    transform: translateY(22px);
    transition:
      opacity 0.5s ease,
      transform 0.5s ease,
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  .aw__card:hover {
    border-color: rgba(248, 176, 59, 0.22);
    box-shadow: 0 0 0 1px rgba(248, 176, 59, 0.06);
  }

  .aw__card-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-white);
    margin-bottom: 8px;
    line-height: 1.3;
  }

  .aw__card-desc {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-gray);
  }

  /* ── Closing ─────────────────────────────────────────────── */
  .aw__closing {
    font-size: 1.25rem;
    font-style: italic;
    font-weight: 500;
    color: rgba(248, 176, 59, 0.55);
    text-align: center;
    max-width: 600px;
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  /* ── Visible state (set by IntersectionObserver) ─────────── */
  .aw.is-visible .aw__label,
  .aw.is-visible .aw__heading,
  .aw.is-visible .aw__subtitle,
  .aw.is-visible .aw__closing {
    opacity: 1;
    transform: translateY(0);
  }

  .aw.is-visible .aw__card {
    opacity: 1;
    transform: translateY(0);
  }

  /* stagger cards */
  .aw.is-visible .aw__card:nth-child(1) { transition-delay: 0.20s; }
  .aw.is-visible .aw__card:nth-child(2) { transition-delay: 0.28s; }
  .aw.is-visible .aw__card:nth-child(3) { transition-delay: 0.36s; }
  .aw.is-visible .aw__card:nth-child(4) { transition-delay: 0.44s; }
  .aw.is-visible .aw__card:nth-child(5) { transition-delay: 0.52s; }
  .aw.is-visible .aw__card:nth-child(6) { transition-delay: 0.60s; }

  .aw.is-visible .aw__closing {
    transition-delay: 0.75s;
  }

  /* ── Responsive ──────────────────────────────────────────── */
  @media (max-width: 768px) {
    .aw {
      padding: 40px 20px;
    }

    .aw__heading {
      font-size: 1.75rem;
    }

    .aw__subtitle {
      font-size: 0.95rem;
      margin-bottom: 28px;
    }

    .aw__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
    }

    .aw__card {
      padding: 22px;
    }

    .aw__card-title {
      font-size: 0.875rem;
    }

    .aw__card-desc {
      font-size: 0.8125rem;
    }

    .aw__closing {
      font-size: 1.1rem;
    }
  }

  @media (max-width: 420px) {
    .aw__grid {
      gap: 10px;
    }

    .aw__card {
      padding: 18px;
    }
  }
</style>

<script>
  const section = document.querySelector('.aw');
  if (section) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 }
    );
    observer.observe(section);
  }
</script>
