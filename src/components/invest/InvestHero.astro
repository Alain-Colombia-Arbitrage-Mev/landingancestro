---
interface Props {
  sharePrice: string;
  valuation: string;
}

const { sharePrice, valuation } = Astro.props;
---

<section class="invest-hero">
  <div class="hero-bg">
    <div class="hero-grid"></div>
    <div class="hero-glow"></div>
  </div>

  <div class="hero-content">
    <div class="hero-badge">
      <span class="badge-dot"></span>
      <span>Delaware C-Corp · SAFE Agreement</span>
    </div>

    <h1 class="hero-title">
      ANCESTRO IS A GLOBAL RENEWABLE ENERGY & LIFESTYLE <span class="highlight">REVOLUTION</span>
    </h1>

    <p class="hero-subtitle">
      A private international platform pioneering energy independence, ancestral health, and spiritual awakening — starting with renewable energy infrastructure across emerging markets.
    </p>

    <p class="hero-supporting">
      We are building the operating system for the next global utility, charging network, and regenerative lifestyle movement.
    </p>

    <div class="hero-ctas">
      <a href="#buy-stock" class="cta-primary">
        <span>Buy Ancestro Stock</span>
        <span class="cta-detail">{sharePrice} per share · {valuation} valuation · SAFE</span>
      </a>
      <a href="#deck" class="cta-secondary">
        View Interactive Investor Deck
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .invest-hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 120px 24px 80px;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
    background-size: 60px 60px;
  }

  .hero-glow {
    position: absolute;
    top: 20%;
    left: 50%;
    transform: translateX(-50%);
    width: 800px;
    height: 600px;
    background: radial-gradient(ellipse, rgba(248,176,59,0.08) 0%, transparent 70%);
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 900px;
    text-align: center;
    animation: fadeIn 0.8s ease forwards;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 18px;
    background: rgba(248,176,59,0.1);
    border: 1px solid rgba(248,176,59,0.25);
    border-radius: 100px;
    font-size: 13px;
    font-weight: 500;
    color: var(--color-primary);
    margin-bottom: 32px;
    letter-spacing: 0.02em;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    background: var(--color-primary);
    border-radius: 50%;
    animation: pulse 2s ease-in-out infinite;
  }

  .hero-title {
    font-size: clamp(32px, 5vw, 56px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-white);
    margin-bottom: 24px;
  }

  .highlight {
    color: var(--color-primary);
  }

  .hero-subtitle {
    font-size: clamp(16px, 2vw, 20px);
    line-height: 1.6;
    color: rgba(255,255,255,0.75);
    margin-bottom: 16px;
    max-width: 750px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-supporting {
    font-size: 15px;
    color: rgba(255,255,255,0.5);
    margin-bottom: 40px;
    font-style: italic;
  }

  .hero-ctas {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .cta-primary {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 16px 40px;
    background: var(--color-primary);
    color: var(--color-black);
    font-size: 18px;
    font-weight: 700;
    border-radius: 15px;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .cta-primary:hover {
    background: #ffbe4d;
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(248,176,59,0.35);
  }

  .cta-detail {
    font-size: 12px;
    font-weight: 500;
    opacity: 0.8;
  }

  .cta-secondary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    color: rgba(255,255,255,0.7);
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 12px;
    transition: all 0.2s ease;
  }

  .cta-secondary:hover {
    color: var(--color-white);
    border-color: rgba(255,255,255,0.25);
    background: rgba(255,255,255,0.05);
  }

  .cta-secondary svg {
    transition: transform 0.2s ease;
  }

  .cta-secondary:hover svg {
    transform: translateX(4px);
  }

  @media (max-width: 768px) {
    .invest-hero {
      padding: 100px 20px 60px;
      min-height: auto;
    }

    .hero-title {
      font-size: 28px;
    }

    .cta-primary {
      width: 100%;
      padding: 14px 24px;
      font-size: 16px;
    }

    .cta-secondary {
      width: 100%;
      justify-content: center;
    }
  }
</style>
