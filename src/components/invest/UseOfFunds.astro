---
const funds = [
  { pct: 30, label: "Platform Technology & Operations" },
  { pct: 25, label: "Market Entry" },
  { pct: 20, label: "Legal & Regulatory" },
  { pct: 15, label: "Pre-Sales & Partners" },
  { pct: 10, label: "Infrastructure" },
];
---

<section class="use-of-funds" id="use-of-funds">
  <div class="uof-container">
    <span class="uof-label">ALLOCATION</span>
    <h2 class="uof-heading">Use of Funds</h2>

    <div class="uof-bars">
      {funds.map((f) => (
        <div class="uof-row" data-pct={f.pct}>
          <span class="uof-pct">{f.pct}%</span>
          <div class="uof-track">
            <div class="uof-fill" style={`--target-w: ${f.pct}%`}>
              {f.pct >= 20 && (
                <span class="uof-fill-pct">{f.pct}%</span>
              )}
            </div>
          </div>
          <span class="uof-name">{f.label}</span>
        </div>
      ))}
    </div>

    <p class="uof-note">
      Ancestro is approaching commercial launch and pre-sales across multiple verticals.
    </p>
  </div>
</section>

<style>
  .use-of-funds {
    padding: 56px 24px;
  }

  .uof-container {
    max-width: 900px;
    margin: 0 auto;
  }

  /* ── Label ── */
  .uof-label {
    display: block;
    text-align: center;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: 12px;
  }

  /* ── Heading ── */
  .uof-heading {
    text-align: center;
    font-size: 2.25rem;
    font-weight: 600;
    color: var(--color-white);
    letter-spacing: -0.02em;
    margin: 0 0 32px;
  }

  /* ── Bar grid ── */
  .uof-bars {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 28px;
  }

  .uof-row {
    display: grid;
    grid-template-columns: 54px 1fr auto;
    align-items: center;
    gap: 16px;
    padding: 4px 8px;
    border-radius: 8px;
    transition: background-color 0.2s ease;
  }

  .uof-row:hover {
    background-color: rgba(255, 255, 255, 0.03);
  }

  /* ── Percentage ── */
  .uof-pct {
    font-size: 0.9375rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--color-white);
    text-align: right;
    line-height: 1;
  }

  /* ── Track + fill ── */
  .uof-track {
    height: 32px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 16px;
    overflow: hidden;
    position: relative;
  }

  .uof-fill {
    position: absolute;
    inset: 0;
    width: 0;
    background: linear-gradient(90deg, var(--color-primary) 0%, rgba(248, 176, 59, 0.85) 100%);
    border-radius: 16px;
    transition: width 1s cubic-bezier(0.22, 1, 0.36, 1);
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  .uof-fill.is-visible {
    width: var(--target-w);
  }

  /* ── Percentage inside bar ── */
  .uof-fill-pct {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-white);
    padding-right: 10px;
    line-height: 1;
    opacity: 0;
    transition: opacity 0.4s ease 1s;
  }

  .uof-fill.is-visible .uof-fill-pct {
    opacity: 1;
  }

  /* ── Label ── */
  .uof-name {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-white);
    white-space: nowrap;
    line-height: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }

  /* ── Closing note ── */
  .uof-note {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-gray);
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
  }

  /* ── Responsive ── */
  @media (max-width: 640px) {
    .use-of-funds {
      padding: 36px 20px;
    }

    .uof-heading {
      font-size: 1.75rem;
      margin-bottom: 40px;
    }

    .uof-row {
      grid-template-columns: 44px 1fr;
      grid-template-rows: auto auto;
      gap: 6px 12px;
      padding: 6px 4px;
    }

    .uof-name {
      grid-column: 1 / -1;
      order: 1;
      white-space: normal;
      font-size: 0.8125rem;
      color: rgba(255, 255, 255, 0.6);
      padding-left: 56px;
    }

    .uof-track {
      height: 22px;
    }

    .uof-fill-pct {
      font-size: 0.6875rem;
      padding-right: 6px;
    }
  }
</style>

<script>
  function initUseOfFunds() {
    const section = document.getElementById("use-of-funds");
    if (!section) return;

    const fills = section.querySelectorAll<HTMLElement>(".uof-fill");

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            fills.forEach((fill, i) => {
              setTimeout(() => fill.classList.add("is-visible"), i * 120);
            });
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.25 }
    );

    observer.observe(section);
  }

  // Run on initial load and on Astro client-side navigations
  document.addEventListener("astro:page-load", initUseOfFunds);
  if (document.readyState !== "loading") {
    initUseOfFunds();
  } else {
    document.addEventListener("DOMContentLoaded", initUseOfFunds);
  }
</script>
