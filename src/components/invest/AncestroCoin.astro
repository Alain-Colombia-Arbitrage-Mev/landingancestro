---
---

<section class="ancestro-coin" id="ancestro-coin">
  <div class="container">

    <span class="label">DIGITAL ASSET</span>

    <div class="heading-row">
      <h2 class="heading">Ancestro Coin</h2>
      <span class="badge">ANC</span>
    </div>

    <p class="description">
      A digital asset backed by verified carbon credits — designed not for speculation,
      but as core infrastructure for the Ancestro ecosystem.
    </p>

    <div class="purposes">
      <div class="purpose-card">
        <span class="purpose-number">01</span>
        <h3 class="purpose-title">Carbon Monetization</h3>
        <p class="purpose-desc">Tokenize verified carbon credits into a liquid, tradeable digital asset with transparent provenance.</p>
      </div>
      <div class="purpose-card">
        <span class="purpose-number">02</span>
        <h3 class="purpose-title">Ecosystem Incentives</h3>
        <p class="purpose-desc">Reward conservation efforts, community participation, and sustainable land stewardship across LATAM.</p>
      </div>
      <div class="purpose-card">
        <span class="purpose-number">03</span>
        <h3 class="purpose-title">Stakeholder Alignment</h3>
        <p class="purpose-desc">Align long-term interests of landowners, investors, and communities through shared value creation.</p>
      </div>
    </div>

    <div class="discount-card">
      <div class="discount-content">
        <div>
          <span class="discount-label">33% Discount</span>
          <span class="discount-separator">&mdash;</span>
          <span class="discount-text">Early Presale</span>
        </div>
        <a href="/presale" class="discount-link">
          View Presale
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>

  </div>
</section>

<style>
  .ancestro-coin {
    padding: 64px 24px;
    opacity: 0;
    transform: translateY(32px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ancestro-coin.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
  }

  /* ── Label ── */
  .label {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--color-primary);
    margin-bottom: 20px;
  }

  /* ── Heading + Badge ── */
  .heading-row {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 16px;
    padding-bottom: 16px;
    border-bottom: 1px solid transparent;
    border-image: linear-gradient(to right, rgba(248, 176, 59, 0.3), rgba(248, 176, 59, 0.05) 70%, transparent) 1;
  }

  .heading {
    font-size: clamp(28px, 4vw, 44px);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.1;
    color: var(--color-white);
    margin: 0;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 4px 14px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--color-primary);
    border: 1px solid rgba(248, 176, 59, 0.3);
    border-radius: 100px;
    line-height: 1;
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* ── Description ── */
  .description {
    max-width: 620px;
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-gray);
    margin: 0 0 32px;
  }

  /* ── Purpose Cards ── */
  .purposes {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 28px;
  }

  .purpose-card {
    padding: 32px 28px;
    background: var(--color-white-10, rgba(255, 255, 255, 0.04));
    border: 1px solid var(--color-white-10, rgba(255, 255, 255, 0.06));
    border-radius: 14px;
    transition: border-color 0.3s ease;
  }

  .purpose-card:hover {
    border-color: var(--color-white-20, rgba(255, 255, 255, 0.12));
  }

  .purpose-number {
    display: block;
    font-size: 12px;
    font-weight: 600;
    color: var(--color-primary);
    letter-spacing: 0.04em;
    margin-bottom: 16px;
    font-variant-numeric: tabular-nums;
  }

  .purpose-title {
    font-size: 17px;
    font-weight: 700;
    color: var(--color-white);
    margin: 0 0 10px;
    letter-spacing: -0.01em;
  }

  .purpose-desc {
    font-size: 14px;
    line-height: 1.65;
    color: var(--color-gray);
    margin: 0;
  }

  /* ── Discount Card ── */
  .discount-card {
    background: var(--color-white-10, rgba(255, 255, 255, 0.04));
    border: 1px solid var(--color-white-10, rgba(255, 255, 255, 0.06));
    border-left: 3px solid var(--color-primary);
    border-radius: 14px;
    padding: 28px 32px;
  }

  .discount-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
  }

  .discount-label {
    font-size: 17px;
    font-weight: 700;
    color: var(--color-white);
  }

  .discount-separator {
    margin: 0 10px;
    color: var(--color-gray);
    font-weight: 300;
  }

  .discount-text {
    font-size: 15px;
    color: var(--color-gray);
    font-weight: 500;
  }

  .discount-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: none;
    letter-spacing: 0.01em;
    transition: gap 0.25s ease;
    cursor: pointer;
  }

  .discount-link:hover {
    gap: 12px;
  }

  .discount-link svg {
    transition: transform 0.25s ease;
  }

  .discount-link:hover svg {
    transform: translateX(2px);
  }

  /* ── Stagger children ── */
  .ancestro-coin.is-visible .label,
  .ancestro-coin.is-visible .heading-row,
  .ancestro-coin.is-visible .description,
  .ancestro-coin.is-visible .purposes,
  .ancestro-coin.is-visible .discount-card {
    animation: fadeUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .ancestro-coin.is-visible .label        { animation-delay: 0s; }
  .ancestro-coin.is-visible .heading-row   { animation-delay: 0.06s; }
  .ancestro-coin.is-visible .description   { animation-delay: 0.12s; }
  .ancestro-coin.is-visible .purposes      { animation-delay: 0.2s; }
  .ancestro-coin.is-visible .discount-card { animation-delay: 0.3s; }

  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .ancestro-coin {
      padding: 40px 20px;
    }

    .heading-row {
      gap: 12px;
    }

    .description {
      margin-bottom: 40px;
    }

    .purposes {
      grid-template-columns: 1fr;
      gap: 14px;
      margin-bottom: 32px;
    }

    .purpose-card {
      padding: 24px 22px;
    }

    .discount-card {
      padding: 22px 24px;
    }

    .discount-content {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }

    .discount-separator {
      display: none;
    }

    .discount-text {
      display: block;
      margin-top: 2px;
    }
  }
</style>

<script>
  const sections = document.querySelectorAll<HTMLElement>('.ancestro-coin');
  if (sections.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 }
    );
    sections.forEach((el) => observer.observe(el));
  }
</script>
