---
// Toast notification container that listens to the toast store
---

<div class="toast-container" id="toast-container"></div>

<script>
  import { toasts, removeToast, type Toast } from '../stores/ui';
  
  const container = document.getElementById('toast-container');
  
  function createToastElement(toast: Toast): HTMLElement {
    const el = document.createElement('div');
    el.className = `toast toast-${toast.type}`;
    el.dataset.toastId = toast.id;
    
    const icons = {
      success: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>`,
      error: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M15 9l-6 6M9 9l6 6"/></svg>`,
      warning: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><path d="M12 9v4M12 17h.01"/></svg>`,
      info: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>`,
    };
    
    el.innerHTML = `
      <span class="toast-icon">${icons[toast.type]}</span>
      <span class="toast-message">${toast.message}</span>
      <button class="toast-close" aria-label="Cerrar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>
    `;
    
    // Close button
    el.querySelector('.toast-close')?.addEventListener('click', () => {
      removeToast(toast.id);
    });
    
    return el;
  }
  
  // Subscribe to toast changes
  toasts.subscribe((currentToasts) => {
    if (!container) return;
    
    // Get current toast IDs in DOM
    const existingIds = new Set(
      Array.from(container.children).map(el => (el as HTMLElement).dataset.toastId)
    );
    
    // Add new toasts
    currentToasts.forEach(toast => {
      if (!existingIds.has(toast.id)) {
        const el = createToastElement(toast);
        container.appendChild(el);
        
        // Trigger animation
        requestAnimationFrame(() => {
          el.classList.add('toast-enter');
        });
      }
    });
    
    // Remove old toasts
    const currentIds = new Set(currentToasts.map(t => t.id));
    Array.from(container.children).forEach(child => {
      const id = (child as HTMLElement).dataset.toastId;
      if (id && !currentIds.has(id)) {
        child.classList.add('toast-exit');
        setTimeout(() => child.remove(), 300);
      }
    });
  });
</script>

<style>
  .toast-container {
    position: fixed;
    bottom: 24px;
    right: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    z-index: 9999;
    pointer-events: none;
  }

  :global(.toast) {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    background: rgba(20, 20, 20, 0.95);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    color: var(--color-white);
    font-size: 14px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);
    pointer-events: auto;
    opacity: 0;
    transform: translateX(100%);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    max-width: 380px;
  }

  :global(.toast.toast-enter) {
    opacity: 1;
    transform: translateX(0);
  }

  :global(.toast.toast-exit) {
    opacity: 0;
    transform: translateX(100%);
  }

  :global(.toast-icon) {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
  }

  :global(.toast-icon svg) {
    width: 100%;
    height: 100%;
  }

  :global(.toast-success) {
    border-color: rgba(34, 197, 94, 0.3);
  }

  :global(.toast-success .toast-icon) {
    color: #22c55e;
  }

  :global(.toast-error) {
    border-color: rgba(239, 68, 68, 0.3);
  }

  :global(.toast-error .toast-icon) {
    color: #ef4444;
  }

  :global(.toast-warning) {
    border-color: rgba(245, 158, 11, 0.3);
  }

  :global(.toast-warning .toast-icon) {
    color: #f59e0b;
  }

  :global(.toast-info) {
    border-color: rgba(59, 130, 246, 0.3);
  }

  :global(.toast-info .toast-icon) {
    color: #3b82f6;
  }

  :global(.toast-message) {
    flex: 1;
    line-height: 1.4;
  }

  :global(.toast-close) {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    background: none;
    border: none;
    color: var(--color-gray);
    cursor: pointer;
    border-radius: 6px;
    transition: all 0.2s;
  }

  :global(.toast-close:hover) {
    color: var(--color-white);
    background: rgba(255, 255, 255, 0.1);
  }

  :global(.toast-close svg) {
    width: 16px;
    height: 16px;
  }

  @media (max-width: 480px) {
    .toast-container {
      left: 16px;
      right: 16px;
      bottom: 16px;
    }

    :global(.toast) {
      max-width: 100%;
    }
  }
</style>
