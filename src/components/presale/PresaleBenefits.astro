---
interface Benefit {
  icon: string;
  title: string;
  description: string;
}

interface Props {
  benefits?: Benefit[];
}

const defaultBenefits: Benefit[] = [
  {
    icon: "⚡",
    title: "Precio Exclusivo",
    description: "Compra ANC a $0.88, 30% menos que el precio de listado de $1.25"
  },
  {
    icon: "🔓",
    title: "Vesting Justo",
    description: "15% liberado al listar, resto en 10 meses. Sin cliff period."
  },
  {
    icon: "💎",
    title: "Staking Bonus",
    description: "+5% APY extra durante el primer año para participantes del presale"
  },
  {
    icon: "🌱",
    title: "Utilidad Real",
    description: "ANC impulsa la red de energía solar más grande de LATAM"
  }
];

const props = Astro.props;
const benefits = props.benefits && props.benefits.length > 0 ? props.benefits : defaultBenefits;
---

<section class="benefits-section">
  <div class="benefits-container">
    {benefits.map((benefit) => (
      <div class="benefit-card">
        <span class="benefit-icon">{benefit.icon}</span>
        <h3 class="benefit-title">{benefit.title}</h3>
        <p class="benefit-description">{benefit.description}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .benefits-section {
    padding: 80px 20px;
    background: rgba(248, 176, 59, 0.03);
  }

  .benefits-container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .benefit-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--color-white-10);
    border-radius: 16px;
    padding: 30px;
    text-align: center;
    transition: all 0.3s ease;
  }

  .benefit-card:hover {
    border-color: rgba(248, 176, 59, 0.3);
    transform: translateY(-5px);
  }

  .benefit-icon {
    font-size: 40px;
    display: block;
    margin-bottom: 16px;
  }

  .benefit-title {
    font-size: 18px;
    font-weight: 600;
    color: var(--color-white);
    margin-bottom: 10px;
  }

  .benefit-description {
    font-size: 14px;
    color: var(--color-gray);
    line-height: 1.5;
  }

  @media (max-width: 1024px) {
    .benefits-container {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .benefits-container {
      grid-template-columns: 1fr;
    }
  }
</style>
