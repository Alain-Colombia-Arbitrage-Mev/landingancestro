---
interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  faqs?: FAQItem[];
}

const defaultFaqs: FAQItem[] = [
  {
    question: "¿Por qué debería confiar en ustedes?",
    answer: "No te pedimos que confíes en nosotros—te pedimos que mires los hechos. 18 países, infraestructura real, paneles en techos reales. Nuestro negocio existe con o sin el token. El token es la invitación a participar en algo que ya funciona."
  },
  {
    question: "¿Esto es solo otro token más?",
    answer: "La mayoría de tokens prometen el futuro. Nosotros mostramos el presente. ANC representa participación en una red de energía que ya genera electricidad, ya ahorra dinero a familias, ya reduce emisiones. El token es la capa financiera de algo tangible."
  },
  {
    question: "¿Por qué hay vesting?",
    answer: "Porque no queremos especuladores de corto plazo. Queremos personas comprometidas con la misión. El vesting nos protege a ambos: tú de la volatilidad extrema, nosotros de quienes solo buscan ganancias rápidas."
  },
  {
    question: "¿Qué pasa si el precio cae?",
    answer: "Los precios fluctúan. Las misiones no. Si compras ANC esperando duplicar tu dinero mañana, esto no es para ti. Si compras porque crees que Latinoamérica merece energía limpia y quieres ser parte de esa historia, bienvenido."
  },
  {
    question: "¿Cuál es el mínimo para participar?",
    answer: "$50 USD. No creemos en barreras artificiales. Si crees en la misión, queremos que puedas participar sin importar tu situación financiera. Esto es para todos los que quieren actuar, no solo para los que tienen mucho capital."
  },
  {
    question: "¿Y si no sé nada de crypto?",
    answer: "Perfecto. Hicimos el proceso tan simple como comprar en cualquier tienda online. Tarjeta, transferencia o crypto—tú decides. Y si te trabas, hay humanos reales listos para ayudarte. Porque esto va de incluir, no de excluir."
  },
];

const props = Astro.props;
const faqs = props.faqs && props.faqs.length > 0 ? props.faqs : defaultFaqs;
---

<section class="faq-section">
  <div class="section-header">
    <h2 class="section-title">Preguntas Frecuentes</h2>
  </div>
  
  <div class="faq-grid">
    {faqs && faqs.map((faq) => (
      <div class="faq-item">
        <h4>{faq.question}</h4>
        <p>{faq.answer}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .faq-section {
    padding: 100px 20px;
    max-width: 1000px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 60px;
  }

  .section-title {
    font-size: clamp(28px, 4vw, 48px);
    font-weight: 700;
    color: var(--color-white);
  }

  .faq-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .faq-item {
    padding: 24px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--color-white-10);
    border-radius: 16px;
    transition: all 0.3s ease;
  }

  .faq-item:hover {
    border-color: rgba(248, 176, 59, 0.3);
  }

  .faq-item h4 {
    font-size: 16px;
    color: var(--color-white);
    margin-bottom: 12px;
    line-height: 1.4;
  }

  .faq-item p {
    font-size: 14px;
    color: var(--color-gray);
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .faq-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
