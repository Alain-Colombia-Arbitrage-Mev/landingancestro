---
interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  faqs?: FAQItem[];
}

const defaultFaqs: FAQItem[] = [
  {
    question: "¿Qué es el token ANC?",
    answer: "ANC es el token nativo de Ancestro, utilizado para acceder a servicios de energía solar, recompensas de staking y gobernanza del ecosistema."
  },
  {
    question: "¿Cómo funciona el vesting?",
    answer: "Los tokens comprados en presale se liberan gradualmente: 25% al inicio, y el resto en 6 meses con liberaciones mensuales."
  },
  {
    question: "¿Cuáles son los métodos de pago?",
    answer: "Aceptamos criptomonedas (USDT, USDC, ETH), tarjetas de crédito/débito y transferencias bancarias en países seleccionados."
  },
  {
    question: "¿Hay un mínimo de compra?",
    answer: "El mínimo de compra es de $50 USD. No hay máximo, pero compras mayores a $10,000 requieren verificación KYC."
  },
  {
    question: "¿Cuándo puedo hacer staking?",
    answer: "El staking estará disponible inmediatamente después del lanzamiento oficial. Los tokens en vesting también pueden ser stakeados."
  },
  {
    question: "¿Cómo reclamo mis tokens?",
    answer: "Los tokens se enviarán automáticamente a tu wallet registrada según el calendario de vesting. Recibirás notificaciones por email."
  },
];

const props = Astro.props;
const faqs = props.faqs && props.faqs.length > 0 ? props.faqs : defaultFaqs;
---

<section class="faq-section">
  <div class="section-header">
    <h2 class="section-title">Preguntas Frecuentes</h2>
  </div>
  
  <div class="faq-grid">
    {faqs && faqs.map((faq) => (
      <div class="faq-item">
        <h4>{faq.question}</h4>
        <p>{faq.answer}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .faq-section {
    padding: 100px 20px;
    max-width: 1000px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 60px;
  }

  .section-title {
    font-size: clamp(28px, 4vw, 48px);
    font-weight: 700;
    color: var(--color-white);
  }

  .faq-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .faq-item {
    padding: 24px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--color-white-10);
    border-radius: 16px;
    transition: all 0.3s ease;
  }

  .faq-item:hover {
    border-color: rgba(248, 176, 59, 0.3);
  }

  .faq-item h4 {
    font-size: 16px;
    color: var(--color-white);
    margin-bottom: 12px;
    line-height: 1.4;
  }

  .faq-item p {
    font-size: 14px;
    color: var(--color-gray);
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .faq-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
