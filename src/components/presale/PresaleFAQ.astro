---
interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  faqs: FAQItem[];
}

const { faqs } = Astro.props;
---

<section class="faq-section">
  <div class="section-header">
    <h2 class="section-title">Preguntas Frecuentes</h2>
  </div>
  
  <div class="faq-grid">
    {faqs.map((faq) => (
      <div class="faq-item">
        <h4>{faq.question}</h4>
        <p>{faq.answer}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .faq-section {
    padding: 100px 20px;
    max-width: 1000px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 60px;
  }

  .section-title {
    font-size: clamp(28px, 4vw, 48px);
    font-weight: 700;
    color: var(--color-white);
  }

  .faq-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .faq-item {
    padding: 24px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--color-white-10);
    border-radius: 16px;
    transition: all 0.3s ease;
  }

  .faq-item:hover {
    border-color: rgba(248, 176, 59, 0.3);
  }

  .faq-item h4 {
    font-size: 16px;
    color: var(--color-white);
    margin-bottom: 12px;
    line-height: 1.4;
  }

  .faq-item p {
    font-size: 14px;
    color: var(--color-gray);
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .faq-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
