---
export const prerender = true;
import Layout from '@layouts/Layout.astro';
import Navbar from '@components/Navbar.astro';
import Footer from '@components/Footer.astro';
import Team from '@components/invest/Team.astro';
import { useTranslations } from '../i18n/utils';
import { defaultLang } from '../i18n/languages';

const t = useTranslations(defaultLang);
---

<Layout title="Team - Ancestro" description="Meet the 24-person team building LATAM's energy future. Leadership, technology, infrastructure, and advisory professionals driving renewable innovation.">
  <Navbar />
  <main class="team-page">
    <Team />
  </main>
  <Footer />
</Layout>

<style>
  .team-page {
    padding-top: 79px;
    min-height: 100vh;
    background: var(--color-black);
  }
</style>
