// Presale Configuration
const PRESALE = {
  hardCap: "$13,200,000",
  raised: "$8,883,600",
  progress: 67.3,
  daysRemaining: 150,
  minBuy: 100,
  maxBuy: 50000,
};

// Benefits - Seth Godin style: about change, not features
const BENEFITS = [
  {
    icon: t('presale.benefit1.icon'),
    title: t('presale.benefit1.title'),
    description: t('presale.benefit1.description')
  },
  {
    icon: t('presale.benefit2.icon'),
    title: t('presale.benefit2.title'),
    description: t('presale.benefit2.description')
  },
  {
    icon: t('presale.benefit3.icon'),
    title: t('presale.benefit3.title'),
    description: t('presale.benefit3.description')
  },
  {
    icon: t('presale.benefit4.icon'),
    title: t('presale.benefit4.title'),
    description: t('presale.benefit4.description')
