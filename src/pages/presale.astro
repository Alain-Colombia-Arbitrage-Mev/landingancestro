---
import Layout from '@layouts/Layout.astro';
import Navbar from '@components/Navbar.astro';
import CTA from '@components/CTA.astro';
import Footer from '@components/Footer.astro';

// Token info
const tokenSymbol = "ANC";
const tokenName = "Ancestro";
const presalePrice = 0.88;
const listingPrice = 1.25;
const totalSupply = "100,000,000";
const presaleAllocation = "15,000,000";
const hardCap = "$13,200,000";
const minBuy = 100;
const maxBuy = 50000;

// Vesting schedule
const vestingSchedule = [
  { phase: "TGE", percent: 15, description: "Liberación inmediata al listar" },
  { phase: "Mes 1-2", percent: 17, description: "8.5% mensual" },
  { phase: "Mes 3-4", percent: 17, description: "8.5% mensual" },
  { phase: "Mes 5-6", percent: 17, description: "8.5% mensual" },
  { phase: "Mes 7-8", percent: 17, description: "8.5% mensual" },
  { phase: "Mes 9-10", percent: 17, description: "8.5% mensual + final" },
];

// Staking tiers
const stakingTiers = [
  {
    name: "Flexible",
    apy: 12,
    bonus: 5,
    lock: "Sin bloqueo",
    description: "Retira cuando quieras",
    features: ["Sin período mínimo", "Retiro instantáneo", "Recompensas diarias"],
    recommended: false
  },
  {
    name: "Holder",
    apy: 18,
    bonus: 5,
    lock: "30 días",
    description: "Balance perfecto",
    features: ["Bloqueo de 30 días", "APY aumentado", "Recompensas diarias", "Acceso a airdrops"],
    recommended: true
  },
  {
    name: "Diamond",
    apy: 28,
    bonus: 5,
    lock: "90 días",
    description: "Máximas recompensas",
    features: ["Bloqueo de 90 días", "APY máximo", "Recompensas diarias", "Acceso a airdrops", "Gobernanza DAO"],
    recommended: false
  }
];

// Benefits
const benefits = [
  {
    icon: "⚡",
    title: "Precio Exclusivo",
    description: "Compra ANC a $0.88, 30% menos que el precio de listado de $1.25"
  },
  {
    icon: "🔓",
    title: "Vesting Justo",
    description: "15% liberado al listar, resto en 10 meses. Sin cliff period."
  },
  {
    icon: "💎",
    title: "Staking Bonus",
    description: "+5% APY extra durante el primer año para participantes del presale"
  },
  {
    icon: "🌱",
    title: "Utilidad Real",
    description: "ANC impulsa la red de energía solar más grande de LATAM"
  }
];

const footerBg = "/images/footer-bg.png";
---

<Layout title="Presale ANC Token" description="Participa en el presale del token ANC de Ancestro. Precio exclusivo de $0.88, vesting justo y staking con hasta 33% APY.">
  <div class="presale-page">
    <Navbar />
    
    <main id="main-content">
      <!-- Hero Section -->
      <section class="presale-hero">
        <div class="hero-bg">
          <div class="hero-glow"></div>
          <div class="hero-grid"></div>
        </div>
        
        <div class="hero-content">
          <div class="token-badge">
            <span class="token-icon">◈</span>
            <span class="token-symbol">{tokenSymbol}</span>
            <span class="token-status">PRESALE ACTIVO</span>
          </div>
          
          <h1 class="hero-title">
            El Token que Impulsa la
            <span class="highlight">Revolución Solar</span>
          </h1>
          
          <p class="hero-subtitle">
            Únete al presale de ANC y sé parte de la red de energía renovable más grande de Latinoamérica. 
            Precio exclusivo, vesting transparente y staking con recompensas reales.
          </p>
          
          <!-- Price Display -->
          <div class="price-display">
            <div class="current-price">
              <span class="price-label">Precio Presale</span>
              <span class="price-value">${presalePrice}</span>
              <span class="price-unit">USD</span>
            </div>
            <div class="price-divider"></div>
            <div class="listing-price">
              <span class="price-label">Precio Listado</span>
              <span class="price-value-striked">${listingPrice}</span>
              <span class="price-savings">Ahorra 30%</span>
            </div>
          </div>
          
          <!-- Progress Bar -->
          <div class="progress-section">
            <div class="progress-header">
              <span>Progreso del Presale</span>
              <span class="progress-percent">67.3%</span>
            </div>
            <div class="progress-bar">
              <div class="progress-fill" style="width: 67.3%"></div>
            </div>
            <div class="progress-stats">
              <span><strong>$8,883,600</strong> recaudados</span>
              <span>Hard Cap: <strong>{hardCap}</strong></span>
            </div>
          </div>
          
          <!-- Countdown -->
          <div class="countdown-wrapper">
            <p class="countdown-label">El presale termina en:</p>
            <div class="countdown">
              <div class="countdown-item">
                <span class="countdown-number" id="days">150</span>
                <span class="countdown-text">Días</span>
              </div>
              <div class="countdown-item">
                <span class="countdown-number" id="hours">00</span>
                <span class="countdown-text">Horas</span>
              </div>
              <div class="countdown-item">
                <span class="countdown-number" id="minutes">00</span>
                <span class="countdown-text">Min</span>
              </div>
              <div class="countdown-item">
                <span class="countdown-number" id="seconds">00</span>
                <span class="countdown-text">Seg</span>
              </div>
            </div>
          </div>
          
          <div class="hero-ctas">
            <a href="#buy" class="cta-primary">
              Comprar ANC
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
            <a href="#tokenomics" class="cta-secondary">Ver Tokenomics</a>
          </div>
        </div>
      </section>
      
      <!-- Benefits Section -->
      <section class="benefits-section">
        <div class="benefits-container">
          {benefits.map((benefit) => (
            <div class="benefit-card">
              <span class="benefit-icon">{benefit.icon}</span>
              <h3 class="benefit-title">{benefit.title}</h3>
              <p class="benefit-description">{benefit.description}</p>
            </div>
          ))}
        </div>
      </section>
      
      <!-- Tokenomics Section -->
      <section class="tokenomics-section" id="tokenomics">
        <div class="section-header">
          <span class="section-badge">Tokenomics</span>
          <h2 class="section-title">Distribución del Token ANC</h2>
          <p class="section-subtitle">Diseñado para el crecimiento sostenible y la comunidad</p>
        </div>
        
        <div class="tokenomics-grid">
          <div class="tokenomics-chart">
            <div class="chart-visual">
              <svg viewBox="0 0 200 200" class="donut-chart">
                <circle cx="100" cy="100" r="80" fill="none" stroke="#1a1a1a" stroke-width="30"/>
                <circle cx="100" cy="100" r="80" fill="none" stroke="#f8b03b" stroke-width="30" 
                  stroke-dasharray="75.4 427.3" stroke-dashoffset="0" class="chart-segment"/>
                <circle cx="100" cy="100" r="80" fill="none" stroke="#e9a235" stroke-width="30" 
                  stroke-dasharray="100.5 402.1" stroke-dashoffset="-75.4" class="chart-segment"/>
                <circle cx="100" cy="100" r="80" fill="none" stroke="#d4912e" stroke-width="30" 
                  stroke-dasharray="100.5 402.1" stroke-dashoffset="-175.9" class="chart-segment"/>
                <circle cx="100" cy="100" r="80" fill="none" stroke="#bf8027" stroke-width="30" 
                  stroke-dasharray="75.4 427.3" stroke-dashoffset="-276.5" class="chart-segment"/>
                <circle cx="100" cy="100" r="80" fill="none" stroke="#8b5a1b" stroke-width="30" 
                  stroke-dasharray="50.3 452.4" stroke-dashoffset="-351.9" class="chart-segment"/>
                <circle cx="100" cy="100" r="80" fill="none" stroke="#5c3d12" stroke-width="30" 
                  stroke-dasharray="100.5 402.1" stroke-dashoffset="-402.1" class="chart-segment"/>
              </svg>
              <div class="chart-center">
                <span class="chart-total">{totalSupply}</span>
                <span class="chart-label">Total Supply</span>
              </div>
            </div>
          </div>
          
          <div class="tokenomics-breakdown">
            <div class="token-allocation">
              <div class="allocation-item">
                <div class="allocation-color" style="background: #f8b03b"></div>
                <div class="allocation-info">
                  <span class="allocation-name">Presale</span>
                  <span class="allocation-percent">15%</span>
                </div>
                <span class="allocation-amount">15M ANC</span>
              </div>
              <div class="allocation-item">
                <div class="allocation-color" style="background: #e9a235"></div>
                <div class="allocation-info">
                  <span class="allocation-name">Liquidez</span>
                  <span class="allocation-percent">20%</span>
                </div>
                <span class="allocation-amount">20M ANC</span>
              </div>
              <div class="allocation-item">
                <div class="allocation-color" style="background: #d4912e"></div>
                <div class="allocation-info">
                  <span class="allocation-name">Staking Rewards</span>
                  <span class="allocation-percent">20%</span>
                </div>
                <span class="allocation-amount">20M ANC</span>
              </div>
              <div class="allocation-item">
                <div class="allocation-color" style="background: #bf8027"></div>
                <div class="allocation-info">
                  <span class="allocation-name">Equipo</span>
                  <span class="allocation-percent">15%</span>
                </div>
                <span class="allocation-amount">15M ANC</span>
              </div>
              <div class="allocation-item">
                <div class="allocation-color" style="background: #8b5a1b"></div>
                <div class="allocation-info">
                  <span class="allocation-name">Reserva</span>
                  <span class="allocation-percent">10%</span>
                </div>
                <span class="allocation-amount">10M ANC</span>
              </div>
              <div class="allocation-item">
                <div class="allocation-color" style="background: #5c3d12"></div>
                <div class="allocation-info">
                  <span class="allocation-name">Ecosistema & Marketing</span>
                  <span class="allocation-percent">20%</span>
                </div>
                <span class="allocation-amount">20M ANC</span>
              </div>
            </div>
          </div>
        </div>
      </section>
      
      <!-- Vesting Section -->
      <section class="vesting-section" id="vesting">
        <div class="section-header">
          <span class="section-badge">Vesting</span>
          <h2 class="section-title">Calendario de Liberación</h2>
          <p class="section-subtitle">Transparente, justo y sin sorpresas</p>
        </div>
        
        <div class="vesting-container">
          <div class="vesting-info">
            <div class="vesting-highlight">
              <div class="highlight-icon">🔓</div>
              <div class="highlight-content">
                <h3>15% Disponible al Listar</h3>
                <p>Recibe tokens inmediatamente cuando ANC se liste en exchanges. Sin esperas iniciales.</p>
              </div>
            </div>
            
            <div class="vesting-highlight">
              <div class="highlight-icon">📅</div>
              <div class="highlight-content">
                <h3>10 Meses de Liberación Lineal</h3>
                <p>El 85% restante se libera gradualmente cada mes. Predecible y transparente.</p>
              </div>
            </div>
            
            <div class="vesting-highlight">
              <div class="highlight-icon">✨</div>
              <div class="highlight-content">
                <h3>Sin Cliff Period</h3>
                <p>No hay período de espera forzado. Comienza a recibir desde el día 1.</p>
              </div>
            </div>
          </div>
          
          <div class="vesting-timeline">
            <div class="timeline-header">
              <span>Cronograma de Vesting</span>
            </div>
            {vestingSchedule.map((item, index) => (
              <div class="timeline-item">
                <div class="timeline-phase">{item.phase}</div>
                <div class="timeline-bar">
                  <div class="timeline-fill" style={`width: ${item.percent}%`}></div>
                </div>
                <div class="timeline-percent">{item.percent}%</div>
              </div>
            ))}
            <div class="timeline-total">
              <span>Total liberado después de 10 meses</span>
              <span class="total-percent">100%</span>
            </div>
          </div>
        </div>
      </section>
      
      <!-- Staking Section -->
      <section class="staking-section" id="staking">
        <div class="section-header">
          <span class="section-badge">Staking</span>
          <h2 class="section-title">Gana Mientras Sostienes</h2>
          <p class="section-subtitle">Planes de staking simples y recompensas alcanzables</p>
        </div>
        
        <div class="staking-bonus-banner">
          <span class="bonus-icon">🎁</span>
          <span class="bonus-text">Participantes del presale reciben <strong>+5% APY bonus</strong> durante el primer año</span>
        </div>
        
        <div class="staking-grid">
          {stakingTiers.map((tier) => (
            <div class:list={["staking-card", { recommended: tier.recommended }]}>
              {tier.recommended && <span class="recommended-badge">Más Popular</span>}
              <div class="staking-header">
                <h3 class="staking-name">{tier.name}</h3>
                <p class="staking-desc">{tier.description}</p>
              </div>
              
              <div class="staking-apy">
                <span class="apy-value">{tier.apy}%</span>
                <span class="apy-label">APY Base</span>
              </div>
              
              <div class="staking-bonus">
                <span class="bonus-badge">+{tier.bonus}% Presale Bonus</span>
                <span class="total-apy">= {tier.apy + tier.bonus}% APY Total</span>
              </div>
              
              <div class="staking-lock">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                  <rect x="3" y="11" width="18" height="11" rx="2" stroke="currentColor" stroke-width="2"/>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4" stroke="currentColor" stroke-width="2"/>
                </svg>
                <span>{tier.lock}</span>
              </div>
              
              <ul class="staking-features">
                {tier.features.map((feature) => (
                  <li>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                      <path d="M20 6L9 17L4 12" stroke="#f8b03b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    {feature}
                  </li>
                ))}
              </ul>
              
              <button class="staking-cta">
                Seleccionar Plan
              </button>
            </div>
          ))}
        </div>
        
        <div class="staking-calculator">
          <h4>Calculadora de Recompensas</h4>
          <div class="calc-inputs">
            <div class="calc-group">
              <label>Cantidad de ANC</label>
              <input type="number" id="stake-amount" value="10000" min="100" />
            </div>
            <div class="calc-group">
              <label>Plan de Staking</label>
              <select id="stake-plan">
                <option value="17">Flexible (17% APY con bonus)</option>
                <option value="23" selected>Holder (23% APY con bonus)</option>
                <option value="33">Diamond (33% APY con bonus)</option>
              </select>
            </div>
          </div>
          <div class="calc-results">
            <div class="calc-result">
              <span class="result-label">Recompensa Mensual</span>
              <span class="result-value" id="monthly-reward">191.67 ANC</span>
            </div>
            <div class="calc-result">
              <span class="result-label">Recompensa Anual</span>
              <span class="result-value" id="yearly-reward">2,300 ANC</span>
            </div>
            <div class="calc-result highlight">
              <span class="result-label">Valor en USD (al precio actual)</span>
              <span class="result-value" id="usd-value">$2,024</span>
            </div>
          </div>
        </div>
      </section>
      
      <!-- Buy Section -->
      <section class="buy-section" id="buy">
        <div class="section-header">
          <span class="section-badge">Comprar ANC</span>
          <h2 class="section-title">Participa en el Presale</h2>
          <p class="section-subtitle">Proceso simple y seguro</p>
        </div>
        
        <div class="buy-container">
          <div class="buy-card">
            <div class="buy-header">
              <div class="buy-price">
                <span class="buy-price-label">Precio por token</span>
                <span class="buy-price-value">${presalePrice} USD</span>
              </div>
              <div class="buy-limits">
                <span>Mín: ${minBuy} USD</span>
                <span>Máx: ${maxBuy.toLocaleString()} USD</span>
              </div>
            </div>
            
            <form class="buy-form" id="buy-form">
              <div class="form-group">
                <label>Cantidad en USD</label>
                <div class="input-with-max">
                  <input type="number" id="buy-amount" name="amount" min={minBuy} max={maxBuy} value="1000" required />
                  <button type="button" class="max-btn" id="max-btn">MAX</button>
                </div>
              </div>
              
              <div class="tokens-preview">
                <span>Recibirás aproximadamente</span>
                <span class="tokens-amount" id="tokens-preview">1,136.36 ANC</span>
              </div>
              
              <div class="form-group">
                <label>Wallet Address</label>
                <input type="text" id="wallet" name="wallet" placeholder="0x..." required />
              </div>
              
              <div class="form-group">
                <label>Email (para notificaciones)</label>
                <input type="email" id="email" name="email" placeholder="tu@email.com" required />
              </div>
              
              <div class="payment-methods">
                <span class="payment-label">Métodos de pago:</span>
                <div class="payment-options">
                  <button type="button" class="payment-btn active" data-method="usdt">USDT</button>
                  <button type="button" class="payment-btn" data-method="usdc">USDC</button>
                  <button type="button" class="payment-btn" data-method="eth">ETH</button>
                  <button type="button" class="payment-btn" data-method="card">Card</button>
                </div>
              </div>
              
              <div class="form-group checkbox-group">
                <input type="checkbox" id="terms" name="terms" required />
                <label for="terms">Acepto los <a href="/terms">Términos</a> y <a href="/privacy">Política de Privacidad</a></label>
              </div>
              
              <button type="submit" class="buy-submit">
                Comprar ANC
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                  <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            </form>
            
            <div class="buy-security">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="currentColor" stroke-width="2"/>
              </svg>
              <span>Transacción segura • Smart Contract auditado</span>
            </div>
          </div>
          
          <div class="buy-info">
            <h3>¿Por qué comprar ANC?</h3>
            
            <div class="info-item">
              <div class="info-icon">🌍</div>
              <div class="info-content">
                <h4>Utilidad Real</h4>
                <p>ANC es el token de utilidad de la red Ancestro, usándose para pagos, recompensas y gobernanza en la plataforma de energía solar.</p>
              </div>
            </div>
            
            <div class="info-item">
              <div class="info-icon">📈</div>
              <div class="info-content">
                <h4>Potencial de Crecimiento</h4>
                <p>El mercado de energía solar en LATAM está proyectado a crecer 400% en los próximos 5 años. ANC está posicionado para capturar este crecimiento.</p>
              </div>
            </div>
            
            <div class="info-item">
              <div class="info-icon">🔒</div>
              <div class="info-content">
                <h4>Seguridad</h4>
                <p>Smart contract auditado por firmas líderes. Equipo doxxeado y comprometido con la transparencia total.</p>
              </div>
            </div>
            
            <div class="roadmap-preview">
              <h4>Próximos Hitos</h4>
              <div class="milestone">
                <span class="milestone-date">Q2 2026</span>
                <span class="milestone-text">Listado en DEX + CEX Tier 2</span>
              </div>
              <div class="milestone">
                <span class="milestone-date">Q3 2026</span>
                <span class="milestone-text">Lanzamiento App + Staking</span>
              </div>
              <div class="milestone">
                <span class="milestone-date">Q4 2026</span>
                <span class="milestone-text">Expansión a 5 países más</span>
              </div>
            </div>
          </div>
        </div>
      </section>
      
      <!-- FAQ Section -->
      <section class="faq-section">
        <div class="section-header">
          <h2 class="section-title">Preguntas Frecuentes</h2>
        </div>
        
        <div class="faq-grid">
          <div class="faq-item">
            <h4>¿Cuándo recibiré mis tokens?</h4>
            <p>El 15% de tus tokens se liberará inmediatamente al listarse ANC en exchanges. El resto se libera mensualmente durante 10 meses.</p>
          </div>
          <div class="faq-item">
            <h4>¿Puedo hacer staking durante el vesting?</h4>
            <p>Sí, puedes hacer staking con los tokens que ya estén liberados. No necesitas esperar a tener el 100%.</p>
          </div>
          <div class="faq-item">
            <h4>¿Cuál es el mínimo para participar?</h4>
            <p>El mínimo es de $100 USD y el máximo por wallet es de $50,000 USD.</p>
          </div>
          <div class="faq-item">
            <h4>¿Cuándo se lista ANC?</h4>
            <p>El listado está programado para Q2 2026, después de finalizar el presale y completar las auditorías.</p>
          </div>
        </div>
      </section>
    </main>
    
    <Footer backgroundImage={footerBg} />
  </div>
</Layout>

<script define:vars={{ presalePrice }}>
  // Countdown Timer - 150 days from now
  const endDate = new Date();
  endDate.setDate(endDate.getDate() + 150);
  
  function updateCountdown() {
    const now = new Date().getTime();
    const distance = endDate.getTime() - now;
    
    if (distance < 0) {
      document.querySelectorAll('.countdown-number').forEach(el => el.textContent = '00');
      return;
    }
    
    const days = Math.floor(distance / (1000 * 60 * 60 * 24));
    const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
    const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
    const seconds = Math.floor((distance % (1000 * 60)) / 1000);
    
    const daysEl = document.getElementById('days');
    const hoursEl = document.getElementById('hours');
    const minutesEl = document.getElementById('minutes');
    const secondsEl = document.getElementById('seconds');
    
    if (daysEl) daysEl.textContent = days.toString().padStart(2, '0');
    if (hoursEl) hoursEl.textContent = hours.toString().padStart(2, '0');
    if (minutesEl) minutesEl.textContent = minutes.toString().padStart(2, '0');
    if (secondsEl) secondsEl.textContent = seconds.toString().padStart(2, '0');
  }
  
  updateCountdown();
  setInterval(updateCountdown, 1000);
  
  // Staking Calculator
  const stakeAmount = document.getElementById('stake-amount');
  const stakePlan = document.getElementById('stake-plan');
  const monthlyReward = document.getElementById('monthly-reward');
  const yearlyReward = document.getElementById('yearly-reward');
  const usdValue = document.getElementById('usd-value');
  
  function updateCalculator() {
    const amount = parseFloat(stakeAmount?.value || '10000');
    const apy = parseFloat(stakePlan?.value || '23');
    
    const yearly = amount * (apy / 100);
    const monthly = yearly / 12;
    const usd = yearly * presalePrice;
    
    if (monthlyReward) monthlyReward.textContent = monthly.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ",") + ' ANC';
    if (yearlyReward) yearlyReward.textContent = yearly.toFixed(0).replace(/\B(?=(\d{3})+(?!\d))/g, ",") + ' ANC';
    if (usdValue) usdValue.textContent = '$' + usd.toFixed(0).replace(/\B(?=(\d{3})+(?!\d))/g, ",");
  }
  
  stakeAmount?.addEventListener('input', updateCalculator);
  stakePlan?.addEventListener('change', updateCalculator);
  
  // Buy form - token preview
  const buyAmount = document.getElementById('buy-amount');
  const tokensPreview = document.getElementById('tokens-preview');
  const maxBtn = document.getElementById('max-btn');
  
  function updateTokensPreview() {
    const amount = parseFloat(buyAmount?.value || '1000');
    const tokens = amount / presalePrice;
    if (tokensPreview) {
      tokensPreview.textContent = tokens.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ",") + ' ANC';
    }
  }
  
  buyAmount?.addEventListener('input', updateTokensPreview);
  maxBtn?.addEventListener('click', () => {
    if (buyAmount) {
      buyAmount.value = '50000';
      updateTokensPreview();
    }
  });
  
  // Payment method selection
  const paymentBtns = document.querySelectorAll('.payment-btn');
  paymentBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      paymentBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
    });
  });
  
  // Form submission
  const buyForm = document.getElementById('buy-form');
  buyForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    alert('¡Gracias por tu interés! La funcionalidad de compra se habilitará pronto.');
  });
</script>

