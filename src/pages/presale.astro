---
import Layout from '@layouts/Layout.astro';
import Navbar from '@components/Navbar.astro';
import Footer from '@components/Footer.astro';

// Presale Components
import PresaleHero from '@components/presale/PresaleHero.astro';
import PresaleBenefits from '@components/presale/PresaleBenefits.astro';
import PresaleManifesto from '@components/presale/PresaleManifesto.astro';
import Tokenomics from '@components/presale/Tokenomics.astro';
import VestingSchedule from '@components/presale/VestingSchedule.astro';
import StakingTiers from '@components/presale/StakingTiers.astro';
import StakingCalculator from '@components/presale/StakingCalculator.astro';
import BuyForm from '@components/presale/BuyForm.astro';
import PresaleFAQ from '@components/presale/PresaleFAQ.astro';

// ============================================
// CONFIGURATION - Easy to modify
// ============================================

// Token Configuration
const TOKEN = {
  symbol: "ANC",
  name: "Ancestro",
  presalePrice: 0.88,
  listingPrice: 1.25,
  totalSupply: "100,000,000",
  presaleAllocation: "15,000,000",
};

// Presale Configuration
const PRESALE = {
  hardCap: "$13,200,000",
  raised: "$8,883,600",
  progress: 67.3,
  daysRemaining: 150,
  minBuy: 100,
  maxBuy: 50000,
};

// Benefits - Seth Godin style: about change, not features
const BENEFITS = [
  {
    icon: "🔥",
    title: "No es para todos",
    description: "Esto es para quienes entienden que el cambio no sucede solo—se construye. Los primeros siempre llevan la antorcha."
  },
  {
    icon: "🤝",
    title: "Confianza, no promesas",
    description: "Vesting transparente porque creemos en relaciones largas. 15% al listar, el resto en 10 meses. Sin trucos."
  },
  {
    icon: "⚡",
    title: "Impacto medible",
    description: "Cada ANC representa paneles solares reales en techos reales. Tu inversión tiene nombre, apellido y dirección."
  },
  {
    icon: "🌎",
    title: "La tribu correcta",
    description: "650 millones de latinoamericanos merecen energía limpia. Estás eligiendo el lado correcto de la historia."
  }
];

// Tokenomics Allocations
const ALLOCATIONS = [
  { name: "Presale", percent: 15, amount: "15M ANC", color: "#f8b03b" },
  { name: "Liquidez", percent: 20, amount: "20M ANC", color: "#e9a235" },
  { name: "Staking Rewards", percent: 20, amount: "20M ANC", color: "#d4912e" },
  { name: "Equipo", percent: 15, amount: "15M ANC", color: "#bf8027" },
  { name: "Reserva", percent: 10, amount: "10M ANC", color: "#8b5a1b" },
  { name: "Ecosistema & Marketing", percent: 20, amount: "20M ANC", color: "#5c3d12" },
];

// Vesting Schedule
const VESTING_SCHEDULE = [
  { phase: "TGE", percent: 15, description: "Liberación inmediata al listar" },
  { phase: "Mes 1-2", percent: 17, description: "8.5% mensual" },
  { phase: "Mes 3-4", percent: 17, description: "8.5% mensual" },
  { phase: "Mes 5-6", percent: 17, description: "8.5% mensual" },
  { phase: "Mes 7-8", percent: 17, description: "8.5% mensual" },
  { phase: "Mes 9-10", percent: 17, description: "8.5% mensual + final" },
];

// Staking Tiers
const STAKING_TIERS = [
  {
    name: "Flexible",
    apy: 12,
    bonus: 5,
    lock: "Sin bloqueo",
    description: "Retira cuando quieras",
    features: ["Sin período mínimo", "Retiro instantáneo", "Recompensas diarias"],
    recommended: false
  },
  {
    name: "Holder",
    apy: 18,
    bonus: 5,
    lock: "30 días",
    description: "Balance perfecto",
    features: ["Bloqueo de 30 días", "APY aumentado", "Recompensas diarias", "Acceso a airdrops"],
    recommended: true
  },
  {
    name: "Diamond",
    apy: 28,
    bonus: 5,
    lock: "90 días",
    description: "Máximas recompensas",
    features: ["Bloqueo de 90 días", "APY máximo", "Recompensas diarias", "Acceso a airdrops", "Gobernanza DAO"],
    recommended: false
  }
];

// FAQ - Seth Godin style: address real objections with honest answers
const FAQS = [
  {
    question: "¿Por qué debería confiar en ustedes?",
    answer: "No te pedimos que confíes—te pedimos que mires los hechos. 18 países, infraestructura real, paneles en techos reales. El token es la invitación a participar en algo que ya funciona."
  },
  {
    question: "¿Esto es solo otro token más?",
    answer: "La mayoría de tokens prometen el futuro. Nosotros mostramos el presente. ANC representa participación en una red de energía que ya genera electricidad, ya ahorra dinero a familias, ya reduce emisiones."
  },
  {
    question: "¿Por qué hay vesting?",
    answer: "Porque no queremos especuladores de corto plazo. Queremos personas comprometidas con la misión. El vesting nos protege a ambos: tú de la volatilidad extrema, nosotros de quienes solo buscan ganancias rápidas."
  },
  {
    question: "¿Qué pasa si el precio cae?",
    answer: "Los precios fluctúan. Las misiones no. Si compras esperando duplicar tu dinero mañana, esto no es para ti. Si crees que LATAM merece energía limpia y quieres ser parte de esa historia, bienvenido."
  },
  {
    question: "¿Y si no sé nada de crypto?",
    answer: "Perfecto. Hicimos el proceso tan simple como comprar en cualquier tienda online. Tarjeta, transferencia o crypto—tú decides. Y si te trabas, hay humanos reales listos para ayudarte."
  },
  {
    question: "¿Cuál es el mínimo para participar?",
    answer: "$100 USD. No creemos en barreras artificiales. Si crees en la misión, queremos que puedas participar sin importar tu situación financiera."
  }
];

// Footer background
const footerBg = "/images/footer-bg.png";
---

<Layout 
  title="Presale ANC Token" 
  description="Participa en el presale del token ANC de Ancestro. Precio exclusivo de $0.88, vesting justo y staking con hasta 33% APY."
>
  <div class="presale-page">
    <Navbar />
    
    <main id="main-content">
      <!-- Hero Section -->
      <PresaleHero 
        tokenSymbol={TOKEN.symbol}
        presalePrice={TOKEN.presalePrice}
        listingPrice={TOKEN.listingPrice}
        hardCap={PRESALE.hardCap}
        raised={PRESALE.raised}
        progress={PRESALE.progress}
        daysRemaining={PRESALE.daysRemaining}
      />
      
      <!-- Benefits Section -->
      <PresaleBenefits benefits={BENEFITS} />
      
      <!-- Manifesto Section - The change we seek to make -->
      <PresaleManifesto />
      
      <!-- Tokenomics Section -->
      <Tokenomics 
        totalSupply={TOKEN.totalSupply}
        allocations={ALLOCATIONS}
      />
      
      <!-- Vesting Schedule Section -->
      <VestingSchedule 
        schedule={VESTING_SCHEDULE}
        tgePercent={15}
        vestingMonths={10}
      />
      
      <!-- Staking Tiers Section -->
      <StakingTiers tiers={STAKING_TIERS} />
      
      <!-- Staking Calculator -->
      <div class="calculator-wrapper">
        <StakingCalculator tokenPrice={TOKEN.presalePrice} />
      </div>
      
      <!-- Buy Form Section -->
      <BuyForm 
        tokenSymbol={TOKEN.symbol}
        tokenPrice={TOKEN.presalePrice}
        minBuy={PRESALE.minBuy}
        maxBuy={PRESALE.maxBuy}
      />
      
      <!-- FAQ Section -->
      <PresaleFAQ faqs={FAQS} />
    </main>
    
    <Footer backgroundImage={footerBg} />
  </div>
</Layout>

<style>
  .presale-page {
    background-color: var(--color-black);
    min-height: 100vh;
  }

  main {
    padding-top: 79px;
  }

  .calculator-wrapper {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px 100px;
  }
</style>
