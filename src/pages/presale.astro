];

// Tokenomics Allocations
const ALLOCATIONS = [
  { name: t('presale.tokenomics.presale'), percent: 15, amount: "15M ANC", color: "#f8b03b" },
  { name: t('presale.tokenomics.liquidity'), percent: 20, amount: "20M ANC", color: "#e9a235" },
  { name: t('presale.tokenomics.staking'), percent: 20, amount: "20M ANC", color: "#d4912e" },
  { name: t('presale.tokenomics.team'), percent: 15, amount: "15M ANC", color: "#bf8027" },
  { name: t('presale.tokenomics.reserve'), percent: 10, amount: "10M ANC", color: "#8b5a1b" },
  { name: t('presale.tokenomics.ecosystem'), percent: 20, amount: "20M ANC", color: "#5c3d12" },
