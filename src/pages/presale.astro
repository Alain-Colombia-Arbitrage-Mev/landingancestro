// Vesting Schedule
const VESTING_SCHEDULE = [
  { phase: t('presale.vesting.tge'), percent: 15, description: t('presale.vesting.tgeDesc') },
  { phase: t('presale.vesting.month12'), percent: 17, description: t('presale.vesting.month12Desc') },
  { phase: t('presale.vesting.month34'), percent: 17, description: t('presale.vesting.month34Desc') },
  { phase: t('presale.vesting.month56'), percent: 17, description: t('presale.vesting.month56Desc') },
  { phase: t('presale.vesting.month78'), percent: 17, description: t('presale.vesting.month78Desc') },
  { phase: t('presale.vesting.month910'), percent: 17, description: t('presale.vesting.month910Desc') },
];

// Staking Tiers
const STAKING_TIERS = [
  {
    name: t('presale.staking.flexible.name'),
    apy: 12,
    bonus: 5,
    lock: t('presale.staking.flexible.lock'),
    description: t('presale.staking.flexible.description'),
    features: [
      t('presale.staking.flexible.feature1'),
      t('presale.staking.flexible.feature2'),
      t('presale.staking.flexible.feature3')
    ],
    recommended: false
  },
  {
    name: t('presale.staking.holder.name'),
    apy: 18,
    bonus: 5,
    lock: t('presale.staking.holder.lock'),
    description: t('presale.staking.holder.description'),
    features: [
      t('presale.staking.holder.feature1'),
      t('presale.staking.holder.feature2'),
      t('presale.staking.holder.feature3'),
      t('presale.staking.holder.feature4')
    ],
    recommended: true
  },
  {
    name: t('presale.staking.diamond.name'),
    apy: 28,
    bonus: 5,
    lock: t('presale.staking.diamond.lock'),
    description: t('presale.staking.diamond.description'),
    features: [
      t('presale.staking.diamond.feature1'),
      t('presale.staking.diamond.feature2'),
      t('presale.staking.diamond.feature3'),
      t('presale.staking.diamond.feature4'),
      t('presale.staking.diamond.feature5')
    ],
    recommended: false
  }
];

// FAQ - Seth Godin style: address real objections with honest answers
const FAQS = [
  {
    question: t('presale.faq1.question'),
    answer: t('presale.faq1.answer')
  },
  {
    question: t('presale.faq2.question'),
    answer: t('presale.faq2.answer')
  },
  {
    question: t('presale.faq3.question'),
    answer: t('presale.faq3.answer')
  },
  {
    question: t('presale.faq4.question'),
    answer: t('presale.faq4.answer')
  },
  {
    question: t('presale.faq5.question'),
    answer: t('presale.faq5.answer')
  },
  {
    question: t('presale.faq6.question'),
    answer: t('presale.faq6.answer')
  }
];

// Footer background
const footerBg = "/images/footer-bg.png";

// Gate labels
const gateLabels = {
  title: t('presale.gate.title'),
  subtitle: t('presale.gate.subtitle'),
  tabCode: t('presale.gate.tabCode'),
  tabWhitelist: t('presale.gate.tabWhitelist'),
  codePlaceholder: t('presale.gate.codePlaceholder'),
  verifyCode: t('presale.gate.verifyCode'),
  verifying: t('presale.gate.verifying'),
  emailPlaceholder: t('presale.gate.emailPlaceholder'),
  sendOtp: t('presale.gate.sendOtp'),
  sending: t('presale.gate.sending'),
  otpSent: t('presale.gate.otpSent'),
  verifyOtp: t('presale.gate.verifyOtp'),
  invalidCode: t('presale.gate.invalidCode'),
  notWhitelisted: t('presale.gate.notWhitelisted'),
  invalidOtp: t('presale.gate.invalidOtp'),
  expiredOtp: t('presale.gate.expiredOtp'),
  accessGranted: t('presale.gate.accessGranted'),
  alreadyVerified: t('presale.gate.alreadyVerified'),
  serverError: t('presale.gate.serverError'),
  headline: t('presale.gate.headline'),
  spotsLabel: t('presale.gate.spotsLabel'),
  spotsOf: t('presale.gate.spotsOf'),
  membersJoined: t('presale.gate.membersJoined'),
  countriesLabel: t('presale.gate.countriesLabel'),
  benefit1: t('presale.gate.benefit1'),
  benefit2: t('presale.gate.benefit2'),
  benefit3: t('presale.gate.benefit3'),
  benefit4: t('presale.gate.benefit4'),
  formName: t('presale.gate.formName'),
  formEmail: t('presale.gate.formEmail'),
  formPhone: t('presale.gate.formPhone'),
  formAmount: t('presale.gate.formAmount'),
  formCountry: t('presale.gate.formCountry'),
  formSubmit: t('presale.gate.formSubmit'),
  formSubmitting: t('presale.gate.formSubmitting'),
  formDisclaimer: t('presale.gate.formDisclaimer'),
  successTitle: t('presale.gate.successTitle'),
  successMsg: t('presale.gate.successMsg'),
  orUseCode: t('presale.gate.orUseCode'),
  orLogin: t('presale.gate.orLogin'),
  loginEmail: t('presale.gate.loginEmail'),
  loginPassword: t('presale.gate.loginPassword'),
  loginButton: t('presale.gate.loginButton'),
  loginLoading: t('presale.gate.loginLoading'),
  loginError: t('presale.gate.loginError'),
  loginWithGoogle: t('presale.gate.loginWithGoogle'),
  backToMain: t('presale.gate.backToMain'),
};

// Web3 labels
const walletLabels = {
  connect: t('web3.connectWallet'),
  disconnect: t('web3.disconnect'),
  connected: t('web3.connected'),
  connecting: t('web3.connecting'),
  noWallet: t('web3.noWallet'),
  balance: t('web3.balance'),
};
---

<Layout
  title={t('presale.meta.title')}
  description={t('presale.meta.description')}
>
  <div class="presale-page">
    <Navbar />
    
    <div id="presale-gate-section">
      <PresaleGate client:load labels={gateLabels} lang={defaultLang} />
    </div>

    <div id="presale-content" style="display:none">
    <main id="main-content">
      <!-- Hero Section -->
      <PresaleHero 
        tokenSymbol={TOKEN.symbol}
        presalePrice={TOKEN.presalePrice}
        listingPrice={TOKEN.listingPrice}
        hardCap={PRESALE.hardCap}
        raised={PRESALE.raised}
        progress={PRESALE.progress}
        daysRemaining={PRESALE.daysRemaining}
      />

      <!-- Web3 Wallet Connection -->
      <div class="wallet-section">
        <ConnectWallet client:load labels={walletLabels} />
      </div>
      
      <!-- Benefits Section -->
      <PresaleBenefits benefits={BENEFITS} />
      
      <!-- Manifesto Section - The change we seek to make -->
      <PresaleManifesto />
      
      <!-- Tokenomics Section -->
      <Tokenomics 
        totalSupply={TOKEN.totalSupply}
        allocations={ALLOCATIONS}
      />
      
      <!-- Vesting Schedule Section -->
      <VestingSchedule 
        schedule={VESTING_SCHEDULE}
        tgePercent={15}
        vestingMonths={10}
      />
      
      <!-- Staking Tiers Section -->
      <StakingTiers tiers={STAKING_TIERS} />
      
      <!-- Staking Calculator -->
      <div class="calculator-wrapper">
        <StakingCalculator tokenPrice={TOKEN.presalePrice} />
      </div>
      
      <!-- Buy Form Section -->
      <BuyForm 
        tokenSymbol={TOKEN.symbol}
        tokenPrice={TOKEN.presalePrice}
        minBuy={PRESALE.minBuy}
        maxBuy={PRESALE.maxBuy}
      />
      
      <!-- FAQ Section -->
      <PresaleFAQ faqs={FAQS} />
    </main>
    
    <!-- Sticky Presale Bar -->
    <PresaleBar 
      daysRemaining={PRESALE.daysRemaining}
      tokenSymbol={TOKEN.symbol}
      progress={PRESALE.progress}
    />
    
    <Footer backgroundImage={footerBg} />
    </div>

    <!-- Purchase Notifications (always visible for social proof) -->
    <PurchaseToasts tokenSymbol={TOKEN.symbol} />
  </div>
</Layout>

<style>
  .presale-page {
    background-color: var(--color-black);
    min-height: 100vh;
  }

  #presale-gate-section {
    padding-top: 79px;
  }

  main {
    padding-top: 79px;
  }

  .calculator-wrapper {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px 100px;
  }

  .wallet-section {
    display: flex;
    justify-content: center;
    padding: 24px 20px 0;
  }
</style>
