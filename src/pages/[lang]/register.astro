---
export const prerender = true;
import Layout from '@layouts/Layout.astro';
import Navbar from '@components/Navbar.astro';
import RegisterForm from '@components/auth/RegisterForm';
import { getLanguagePaths } from '../../i18n/config';
import { useTranslations, useTranslatedPath, type Lang } from '../../i18n/utils';

export function getStaticPaths() {
  return getLanguagePaths();
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const labels = {
  title: t('auth.register'),
  subtitle: t('auth.registerSubtitle'),
  name: t('auth.name'),
  email: t('auth.email'),
  phone: t('auth.phone'),
  password: t('auth.password'),
  confirmPassword: t('auth.confirmPassword'),
  registerButton: t('auth.register'),
  registering: t('auth.registering'),
  orContinueWith: t('auth.orContinueWith'),
  googleLogin: t('auth.googleLogin'),
  hasAccount: t('auth.hasAccount'),
  login: t('auth.login'),
  passwordsNoMatch: t('auth.passwordsNoMatch'),
  showPassword: 'Show password',
  hidePassword: 'Hide password',
};
---

<Layout title={t('auth.register')}>
  <Navbar />
  <RegisterForm
    client:load
    labels={labels}
    loginPath={translatePath('/login')}
    verifyPath={translatePath('/verify')}
    dashboardPath={translatePath('/dashboard')}
    lang={lang}
  />
</Layout>
