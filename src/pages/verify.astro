---
export const prerender = true;
import Layout from '@layouts/Layout.astro';
import Navbar from '@components/Navbar.astro';
import VerifyForm from '@components/auth/VerifyForm';
import { useTranslations, useTranslatedPath } from '../i18n/utils';
import { defaultLang } from '../i18n/languages';

const t = useTranslations(defaultLang);
const translatePath = useTranslatedPath(defaultLang);

const labels = {
  title: t('auth.verifyTitle'),
  subtitle: t('auth.verifySubtitle'),
  verifyButton: t('auth.verify'),
  verifying: t('auth.verifying'),
  resendCode: t('auth.resendCode'),
  codeSent: t('auth.codeSent'),
  verified: t('auth.verified'),
};
---

<Layout title={t('auth.verifyTitle')}>
  <Navbar />
  <VerifyForm
    client:load
    labels={labels}
    registerPath={translatePath('/register')}
    loginPath={translatePath('/login')}
    lang={defaultLang}
  />
</Layout>
