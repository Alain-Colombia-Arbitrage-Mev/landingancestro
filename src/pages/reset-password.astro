---
import Layout from '@layouts/Layout.astro';
import Navbar from '@components/Navbar.astro';
import ResetPasswordForm from '@components/auth/ResetPasswordForm';
import { useTranslations, useTranslatedPath } from '../i18n/utils';
import { defaultLang } from '../i18n/languages';

const t = useTranslations(defaultLang);
const translatePath = useTranslatedPath(defaultLang);

const labels = {
  title: t('auth.resetTitle'),
  subtitle: t('auth.resetSubtitle'),
  code: t('auth.verifyCode'),
  newPassword: t('auth.newPassword'),
  confirmPassword: t('auth.confirmPassword'),
  resetButton: t('auth.resetPassword'),
  resetting: t('auth.resetting'),
  backToLogin: t('auth.login'),
  passwordsNoMatch: t('auth.passwordsNoMatch'),
  passwordChanged: t('auth.passwordChanged'),
  showPassword: 'Mostrar contraseña',
  hidePassword: 'Ocultar contraseña',
};
---

<Layout title={t('auth.resetTitle')}>
  <Navbar />
  <ResetPasswordForm
    client:load
    labels={labels}
    loginPath={translatePath('/login')}
    forgotPasswordPath={translatePath('/forgot-password')}
    lang={defaultLang}
  />
</Layout>
